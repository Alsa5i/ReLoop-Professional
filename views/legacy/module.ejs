<%- include('../partials/app-start',{title:mod.label,page:'legacy',heading:'Legacy '+mod.label,subheading:'Original generic data retained for backward compatibility'}) %><section class="card"><div class="card-head"><form method="get" class="filter-row"><input name="q" value="<%= q %>" placeholder="Search records"><button class="btn secondary">Search</button></form><a class="btn primary" href="/legacy/module/<%= mod.key %>/new">Add legacy record</a></div><div class="table-wrap"><table><thead><tr><% mod.fields.forEach(f=>{ %><th><%= f.replaceAll('_',' ') %></th><% }) %><th>Actions</th></tr></thead><tbody><% rows.forEach(r=>{ %><tr><% mod.fields.forEach(f=>{ %><td><%= r.data[f]??'' %></td><% }) %><td><div class="inline-actions"><a class="btn small secondary" href="/legacy/module/<%= mod.key %>/<%= r.id %>/edit">Edit</a><form method="post" action="/legacy/module/<%= mod.key %>/<%= r.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn small danger" data-confirm="Delete this legacy record?">Delete</button></form></div></td></tr><% }) %></tbody></table></div></section><%- include('../partials/app-end') %>
