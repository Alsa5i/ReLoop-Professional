<%- include('../partials/app-start',{title:(row?'Edit ':'Add ')+mod.label,page:'legacy',heading:(row?'Edit ':'Add ')+mod.label,subheading:'Legacy compatibility form'}) %><section class="card form-card"><% if(error){ %><div class="alert danger"><%= error %></div><% } %><form method="post" class="form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% mod.fields.forEach((f,i)=>{ %><label><%= f.replaceAll('_',' ') %><input name="<%= f %>" value="<%= row?.data?.[f]||'' %>" <%= i===0?'required':'' %>></label><% }) %><div class="full"><button class="btn primary"><%= row?'Save Changes':'Create Record' %></button></div></form></section><%- include('../partials/app-end') %>
