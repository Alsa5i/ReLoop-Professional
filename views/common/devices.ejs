<%- include('../partials/app-start',{title:'Devices & security',page:'devices',heading:'Devices & security',subheading:'Manage the devices signed in to your account'}) %>
<section class="card"><h2>Active sessions</h2><p>Up to <%= ({customer:3,collector:2,partner:3,admin:3,owner:2})[user.role] %> devices for your role.</p>
<form method="post" action="/account/devices/revoke-others"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn secondary" data-confirm="Sign out all other devices?">Sign out all other devices</button></form>
<div class="list-stack top-gap"><% rows.forEach(s=>{ %><div class="list-row"><div><strong><%= s.device %> · <%= s.browser %> · <%= s.os %></strong><small>Last active: <%= s.last_active %> · <%= s.current?'Current session':s.created_at %></small></div><form method="post" action="/account/devices/<%= encodeURIComponent(s.sid) %>/revoke"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn secondary small" data-confirm="Revoke this device session?"><%= s.current?'Sign out':'Revoke' %></button></form></div><% }) %></div>
</section><section class="card form-card"><h2>Change password</h2><% if(typeof passwordChanged!=='undefined'&&passwordChanged){ %><div class="alert success" role="status">Password changed. Other sessions were signed out.</div><% } %><% if(typeof error!=='undefined'&&error){ %><div class="alert danger" role="alert"><%= error %></div><% } %>
<form class="form-stack" method="post" action="/account/password"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Current password<input type="password" name="old_password" required autocomplete="current-password"></label><label>New password (12+ characters)<input type="password" name="new_password" required minlength="12" maxlength="200" autocomplete="new-password"></label><label>Confirm new password<input type="password" name="confirm_password" required minlength="12" maxlength="200" autocomplete="new-password"></label><button class="btn primary">Change password and revoke other devices</button></form><p class="field-hint">This also works for the Owner. OWNER_PASSWORD in the server environment remains a controlled recovery/provisioning credential; changing it later rotates the Owner password again.</p></section><%- include('../partials/app-end') %>
