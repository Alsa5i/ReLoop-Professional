<%- include('../partials/app-start',{title:'Support Center',page:'support',heading:'Support Center',subheading:'Get help with your ReLoop account and recycling requests'}) %><% if(typeof error!=="undefined"&&error){ %><div class="alert danger" role="alert"><%= error %></div><% } %><section class="card form-card"><form method="post" action="/support" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Category<select name="category"><% ['account','pickup','payment','collector','partner','technical','other'].forEach(c=>{ %><option value="<%= c %>"><%= c %></option><% }) %></select></label><label>Subject<input required name="subject"></label><label>Message<textarea required name="message"></textarea></label><button class="btn primary">Submit ticket</button></form></section><section class="card"><h2>Your tickets</h2><% rows.forEach(t=>{ %><div class="list-row"><div><strong><%= t.subject %></strong><small><%= t.category %> · <%= t.status %> · <%= t.created_at %></small></div></div><% }) %></section><%- include('../partials/app-end') %>