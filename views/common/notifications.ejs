<%- include('../partials/app-start',{title:'Notifications',page:'notifications',heading:'Notifications',subheading:'Persistent ReLoop updates'}) %><section class="card"><div class="list-stack"><% if(!rows.length){ %><div class="empty">No notifications yet.</div><% } %><% rows.forEach(n=>{ %><article class="notification-item <%= n.is_read?'':'unread' %>"><div><h3><%= n.title %></h3><p><%= n.message %></p><small><%= n.created_at %></small></div><div class="inline-actions"><% if(n.link){ %><a class="btn small" href="<%= n.link %>">Open</a><% } %><% if(!n.is_read){ %><form method="post" action="/notifications/<%= n.id %>/read"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn small secondary">Mark read</button></form><% } %></div></article><% }) %></div></section><%- include('../partials/app-end') %>
