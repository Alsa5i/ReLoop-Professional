<%- include('../partials/app-start',{title:'Profile',page:'profile',heading:'Profile',subheading:'Your ReLoop account'}) %><section class="card form-card"><% if(saved){ %><div class="alert success">Profile updated.</div><% } %><div class="detail-grid"><div><span class="label">Role</span><strong class="capitalize"><%= account.role %></strong></div><div><span class="label">Verification</span><strong><%= account.verification_status %></strong></div><div><span class="label">Status</span><strong><%= account.status %></strong></div><div><span class="label">Joined</span><strong><%= account.created_at %></strong></div></div><form method="post" action="/profile" class="form-grid spaced"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Name<input name="name" value="<%= account.name %>" required></label><label>Email<input value="<%= account.email %>" disabled></label><label>Phone<input name="phone" value="<%= account.phone||'' %>"></label><div class="full"><button class="btn primary">Save profile</button></div></form></section><%- include('../partials/app-end') %>
