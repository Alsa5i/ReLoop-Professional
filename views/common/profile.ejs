<%- include('../partials/app-start',{title:'My profile',page:'profile',heading:'My profile',subheading:'Update your display name and contact details'}) %>
<section class="card form-card"><h2>Account information</h2><% if(saved){ %><div class="alert success" role="status">Your profile was updated.</div><% } %><% if(typeof error!=='undefined'&&error){ %><div class="alert danger" role="alert"><%= error %></div><% } %><div class="detail-grid"><div><span class="label">Role</span><strong class="capitalize"><%= account.role %></strong></div><div><span class="label">Verification</span><strong><%= account.verification_status %></strong></div><div><span class="label">Status</span><strong><%= account.status %></strong></div><div><span class="label">Joined</span><strong><%= account.created_at %></strong></div></div>
<form method="post" action="/profile" class="form-grid spaced" data-draft><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Display name / username<input name="name" autocomplete="name" maxlength="120" minlength="2" value="<%= account.name %>" required></label><label>Username (optional)<input name="username" autocomplete="username" minlength="3" maxlength="30" pattern="[A-Za-z][A-Za-z0-9._-]{2,29}" value="<%= account.username||'' %>" placeholder="Choose a unique username"></label><label>Email (also used to sign in)<input value="<%= account.email %>" disabled></label><label>Phone<input name="phone" type="tel" autocomplete="tel" maxlength="40" value="<%= account.phone||'' %>"></label><div class="full"><button class="btn primary">Save profile</button><p class="field-hint">Available to every role, including the Owner. All five roles can update their name and username. Sign in using your username or email; roles and permissions never change.</p></div></form><p><a href="/account/devices">Change password and manage devices →</a></p></section><%- include('../partials/app-end') %>
