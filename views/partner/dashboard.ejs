<%- include('../partials/app-start',{title:'Partner Dashboard',page:'dashboard',heading:'Partner Workspace',subheading:'Incoming deliveries and received recycling material'}) %><% if(profile?.verification_status!=='verified'){ %><div class="alert warning">Your partner account is <b><%= profile?.verification_status||'pending' %></b>. Full marketplace privileges require manual ReLoop verification.</div><% } %><section class="metric-grid"><article class="metric-card"><span>Incoming</span><strong><%= metrics.incoming %></strong></article><article class="metric-card"><span>Received</span><strong><%= metrics.received %></strong></article><article class="metric-card"><span>Total material</span><strong><%= metrics.weight.toLocaleString() %> kg</strong></article><article class="metric-card"><span>Paid transaction value</span><strong><%= currency %> <%= metrics.transactions.toLocaleString() %></strong></article></section><div class="two-col"><section class="card"><div class="card-head"><div><h2>Incoming deliveries</h2><p>Only pickups assigned to your partner account are shown.</p></div></div><div class="responsive-cards"><% if(!incoming.length){ %><div class="empty">No incoming deliveries.</div><% } %><% incoming.forEach(p=>{ %><article class="pickup-card"><div><span class="badge"><%= p.status %></span><h3><%= p.material_name||'Material' %></h3><p><%= p.reference %> · Collector: <%= p.collector_name||'Not assigned' %></p></div><div class="weight-mini"><span>Collected <b><%= p.collected_weight??'—' %> kg</b></span><span>Verified <b><%= p.verified_weight??'—' %> kg</b></span><% if(['collected','delivered'].includes(p.status)&&!p.partner_receipt_confirmed_at){ %><form method="post" action="/partner/pickups/<%= p.id %>/confirm-delivery"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn small primary">Confirm Receipt</button></form><% } %></div></article><% }) %></div></section><section class="card"><h2>Material breakdown</h2><div class="bar-list"><% if(!breakdown.length){ %><div class="empty">No received material yet.</div><% } %><% breakdown.forEach(b=>{ %><div><div class="bar-label"><span><%= b.name %></span><strong><%= Number(b.weight||0).toFixed(1) %> kg</strong></div><div class="bar-track"><span style="width:<%= metrics.weight>0?Math.max(2,Number(b.weight||0)/metrics.weight*100):0 %>%"></span></div></div><% }) %></div></section></div><section class="card"><div class="card-head"><div><h2>Assigned material batches</h2><p>Traceability for combined material assigned to your facility.</p></div></div><div class="responsive-cards"><% if(!batches.length){ %><div class="empty">No material batches assigned.</div><% } %><% batches.forEach(b=>{ %><article class="pickup-card"><div><span class="badge"><%= b.status %></span><h3><%= b.batch_code %></h3><p><%= b.material_name %> · <%= Number(b.total_weight||0).toLocaleString() %> kg</p></div><div class="weight-mini"><span>Storage <b><%= b.storage_location||'—' %></b></span><span>Delivery <b><%= b.delivery_date||'Not yet' %></b></span></div></article><% }) %></div></section><%- include('../partials/app-end') %>
