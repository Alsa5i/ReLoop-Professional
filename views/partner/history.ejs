<%- include('../partials/app-start',{title:'Delivery History',page:'history',heading:'Delivery History',subheading:'Material assigned and delivered to your facility'}) %><section class="card"><div class="table-wrap"><table><thead><tr><th>Reference</th><th>Material</th><th>Collected</th><th>Verified</th><th>Status</th><th>Date</th></tr></thead><tbody><% if(!rows.length){ %><tr><td colspan="6">No delivery history yet.</td></tr><% } %><% rows.forEach(p=>{ %><tr><td><strong><%= p.reference %></strong></td><td><%= p.material_name||'—' %></td><td><%= p.collected_weight??'—' %> kg</td><td><%= p.verified_weight??'—' %> kg</td><td><span class="badge"><%= p.status %></span></td><td><%= p.delivered_at||p.requested_at %></td></tr><% }) %></tbody></table></div></section><%- include('../partials/app-end') %>
