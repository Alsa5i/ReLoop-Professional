<%- include('../partials/app-start',{title:'Partner Transactions',page:'transactions',heading:'Transaction History',subheading:'Only payment records linked to material assigned to your partner account are shown'}) %>
<section class="card"><div class="table-wrap"><table><thead><tr><th>Payment</th><th>Pickup</th><th>Method</th><th>Transaction value</th><th>Partner allocation</th><th>Status</th><th>Verified</th></tr></thead><tbody><% if(!rows.length){ %><tr><td colspan="7">No linked payment transactions yet.</td></tr><% } %><% rows.forEach(r=>{ %><tr><td><strong><%= r.reference %></strong></td><td><%= r.pickup_reference %></td><td><%= r.method %></td><td><%= currency %> <%= Number(r.gross_value||0).toLocaleString() %></td><td><%= currency %> <%= Number(r.partner_payout||0).toLocaleString() %></td><td><span class="badge <%= r.status==='paid'?'success':r.status==='pending'?'warning':'danger' %>"><%= r.status %></span></td><td><%= r.verified_at||'—' %></td></tr><% }) %></tbody></table></div></section>
<%- include('../partials/app-end') %>
