<%- include('../partials/app-start',{title:'Business Profile',page:'partner-profile',heading:'Business Profile',subheading:'Public-safe partner information and verification status'}) %><section class="card form-card"><% if(saved){ %><div class="alert success">Partner profile updated.</div><% } %><div class="alert info">Verification status: <b><%= row.verification_status %></b>. Registration information and internal verification data are not shown publicly.</div><form method="post" action="/partner/profile" class="form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Business name<input name="business_name" value="<%= row.business_name||'' %>"></label><label>Contact person<input name="contact_person" value="<%= row.contact_person||row.name||'' %>"></label><label>Phone<input name="phone" value="<%= row.phone||'' %>"></label><label>Location<input name="location" value="<%= row.location||'' %>"></label><label class="full">Public profile note<textarea name="profile_notes"><%= row.profile_notes||'' %></textarea></label><div class="full"><button class="btn primary">Save Profile</button></div></form></section><%- include('../partials/app-end') %>
