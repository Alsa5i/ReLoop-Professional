<%- include('../partials/app-start',{title:'Collection History',page:'history',heading:'Collection History',subheading:'Your assigned and completed pickups'}) %><section class="card"><div class="responsive-cards"><% if(!rows.length){ %><div class="empty">No collection history yet.</div><% } %><% rows.forEach(p=>{ %><a class="pickup-card" href="/collector/pickups/<%= p.id %>"><div><span class="badge"><%= p.status %></span><h3><%= p.material_name||'Material' %></h3><p><%= p.reference %> · <%= p.area||p.city||'' %></p></div><div class="weight-mini"><span>Collected <b><%= p.collected_weight??'—' %> kg</b></span><span>Verified <b><%= p.verified_weight??'—' %> kg</b></span></div></a><% }) %></div></section><%- include('../partials/app-end') %>
