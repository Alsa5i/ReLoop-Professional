<%- include('../partials/app-start',{title:'Collector Earnings',page:'earnings',heading:'My Earnings',subheading:'Every payout is linked to a ReLoop pickup and an audited payment record'}) %>
<section class="metric-grid"><article class="metric-card"><span>Pending earnings</span><strong><%= currency %> <%= summary.pending.toLocaleString() %></strong></article><article class="metric-card"><span>Paid earnings</span><strong><%= currency %> <%= summary.paid.toLocaleString() %></strong></article></section>
<section class="card"><div class="table-wrap"><table><thead><tr><th>Payment</th><th>Pickup</th><th>Job status</th><th>Payout</th><th>Payment status</th><th>Date</th></tr></thead><tbody><% if(!rows.length){ %><tr><td colspan="6">No collector earnings have been recorded yet.</td></tr><% } %><% rows.forEach(r=>{ %><tr><td><%= r.reference %></td><td><%= r.pickup_reference %></td><td><span class="badge"><%= r.pickup_status %></span></td><td><strong><%= currency %> <%= Number(r.collector_payout||0).toLocaleString() %></strong></td><td><span class="badge <%= r.status==='paid'?'success':'warning' %>"><%= r.status %></span></td><td><%= r.created_at %></td></tr><% }) %></tbody></table></div><p class="fineprint">Collector payouts can only be recorded after the related pickup is completed. ReLoop does not create standalone or untraceable earnings entries.</p></section>
<%- include('../partials/app-end') %>
