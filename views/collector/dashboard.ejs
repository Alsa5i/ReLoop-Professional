<%- include('../partials/app-start',{title:'Collector Dashboard',page:'dashboard',heading:'Collector Dashboard',subheading:'Mobile-first pickup workflow'}) %><section class="collector-status card"><div><span class="label">Verification</span><strong><%= profile?.verification_status||'pending_verification' %></strong></div><form method="post" action="/collector/availability" class="availability-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Availability<select name="availability" onchange="this.form.submit()"><% ['available','busy','offline'].forEach(s=>{ %><option <%= profile?.availability===s?'selected':'' %>><%= s %></option><% }) %></select></label></form></section><section class="metric-grid"><article class="metric-card"><span>Today</span><strong><%= metrics.today %></strong></article><article class="metric-card"><span>Active</span><strong><%= metrics.active %></strong></article><article class="metric-card"><span>Completed</span><strong><%= metrics.completed %></strong></article><article class="metric-card"><span>Total collected</span><strong><%= metrics.weight.toLocaleString() %> kg</strong></article><article class="metric-card"><span>Paid earnings</span><strong><%= currency %> <%= metrics.paidEarnings.toLocaleString() %></strong></article><article class="metric-card"><span>Pending earnings</span><strong><%= currency %> <%= metrics.pendingEarnings.toLocaleString() %></strong></article></section><section class="card"><div class="card-head"><div><h2>My active pickups</h2><p>Large action cards for use in the field.</p></div></div><div class="job-grid"><% if(!active.length){ %><div class="empty">No active pickups.</div><% } %><% active.forEach(p=>{ %><a class="job-card" href="/collector/pickups/<%= p.id %>"><div class="job-top"><span class="badge"><%= p.status %></span><strong><%= p.reference %></strong></div><h3><%= p.material_name||'Material' %> · <%= p.estimated_weight??'—' %> kg est.</h3><p><%= p.area||p.city||p.address %></p><div class="btn primary wide">Open Pickup</div></a><% }) %></div></section><section class="card"><div class="card-head"><div><h2>Available pickups</h2><p>Only verified collectors marked available can claim jobs.</p></div></div><div class="job-grid"><% if(!available.length){ %><div class="empty"><%= profile?.verification_status!=='verified'?'Verification required before jobs are available.':profile?.availability!=='available'?'Set availability to available to see jobs.':'No approved jobs are available right now.' %></div><% } %><% available.forEach(p=>{ %><article class="job-card"><div class="job-top"><span class="badge success">available</span><strong><%= p.reference %></strong></div><h3><%= p.material_name||'Material' %> · <%= p.estimated_weight??'—' %> kg</h3><p><%= p.area||p.city||p.address %></p><form method="post" action="/collector/jobs/<%= p.id %>/accept"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn primary wide large">Accept Job</button></form></article><% }) %></div></section><%- include('../partials/app-end') %>
