<%- include('../partials/app-start',{title:pickup.reference,page:'dashboard',heading:pickup.reference,subheading:'Assigned pickup'}) %><div class="collector-pickup-head"><div><span class="badge"><%= pickup.status %></span><h1><%= pickup.material_name||'Material' %></h1><p><b><%= pickup.customer_name %></b> · <%= pickup.customer_phone||'No phone' %></p><p><%= pickup.address %> · <%= pickup.area||'' %> <%= pickup.city||'' %></p><% if(pickup.landmark){ %><p>Landmark: <%= pickup.landmark %></p><% } %></div><img class="qr-small" src="/pickup/<%= pickup.id %>/qr.png" alt="Verification QR"></div><section class="weight-mobile"><div><span>Estimated</span><strong><%= pickup.estimated_weight??'—' %> kg</strong></div><div><span>Collected</span><strong><%= pickup.collected_weight??'—' %> kg</strong></div><div><span>Verified</span><strong><%= pickup.verified_weight??'—' %> kg</strong></div></section><section class="card"><h2>Update pickup</h2><div class="collector-actions"><% if(pickup.status==='assigned'){ %><form method="post" action="/collector/pickups/<%= pickup.id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="status" value="accepted"><button class="btn primary field-action">Accept Assigned Job</button></form><% } %><% if(pickup.status==='accepted'){ %><form method="post" action="/collector/pickups/<%= pickup.id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="status" value="en_route"><button class="btn primary field-action">Start Trip</button></form><% } %><% if(pickup.status==='en_route'){ %><form method="post" action="/collector/pickups/<%= pickup.id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="status" value="arrived"><button class="btn primary field-action">I Have Arrived</button></form><% } %><% if(pickup.status==='arrived'){ %><form method="post" action="/collector/pickups/<%= pickup.id %>/status" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="status" value="collected"><label>Collected weight (kg)<input type="number" step="0.01" min="0.01" name="collected_weight" required></label><label>Notes<input name="notes"></label><button class="btn primary field-action">Confirm Collected</button></form><% } %><% if(pickup.status==='collected'){ %><form method="post" action="/collector/pickups/<%= pickup.id %>/status" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="status" value="delivered"><label>Delivery note<input name="notes" placeholder="Partner/facility receipt note"></label><button class="btn primary field-action">Mark Delivered</button></form><% } %><% if(['delivered','verified','completed'].includes(pickup.status)){ %><div class="alert success">Collection stage complete. ReLoop / the partner will handle verification and completion.</div><% } %></div></section><div class="two-col"><section class="card"><h2>Add collection proof</h2><p class="muted">Evidence is private and only visible to authorized participants and ReLoop staff.</p><form method="post" action="/collector/pickups/<%= pickup.id %>/proof" class="form-stack" data-proof-form><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="file_data"><input type="hidden" name="file_name"><label>Proof type<select name="proof_type"><option value="collection_photo">Collection photo</option><option value="material_photo">Material photo</option><option value="weight_receipt">Weight receipt</option><option value="delivery_photo">Delivery photo</option><option value="customer_confirmation">Customer confirmation</option><option value="other">Other</option></select></label><label>File <small>JPEG/PNG/WebP/PDF, max 2 MB</small><input type="file" accept="image/jpeg,image/png,image/webp,application/pdf" data-proof-file></label><label>Notes<textarea name="notes"></textarea></label><button class="btn secondary" type="submit">Save Proof</button><div class="proof-status muted" data-proof-status></div></form><div class="list-stack top-gap"><% proofs.forEach(p=>{ %><div class="list-row"><div><strong><%= p.proof_type %></strong><small><%= p.notes||p.file_name||'' %> · <%= p.created_at %></small></div><% if(p.file_name){ %><a class="btn small secondary" href="/proof/<%= p.id %>" target="_blank">View</a><% } %></div><% }) %></div></section><section class="card"><h2>Status history</h2><div class="timeline compact"><% history.forEach(h=>{ %><article><span></span><div><h3><%= h.new_status %></h3><p><%= h.notes||'Status updated' %></p><small><%= h.created_at %> · <%= h.changed_by_name %></small></div></article><% }) %></div></section></div><%- include('../partials/app-end') %>
