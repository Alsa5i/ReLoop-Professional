<%- include('../partials/head',{title:'Recycling campaigns'}) %><%- include('../partials/public-nav') %><main class="public-section"><div class="public-container"><h1>Recycling campaigns</h1><p>Campaign collection weights use verified pickup records only. No estimated environmental claims are included.</p><div class="material-grid"><% rows.forEach(c=>{ %><article class="card"><h2><%= c.title %></h2><p><%= c.description||'' %></p><p>Sponsored by: <%= c.sponsor||'ReLoop' %></p><strong><%= c.collected_kg %> / <%= c.target_kg %> kg verified</strong><p><%= c.location||'' %></p></article><% }) %></div></div></main><%- include('../partials/foot') %>