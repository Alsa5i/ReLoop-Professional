<%- include('../partials/head',{title:'Environmental Impact'}) %><%- include('../partials/public-nav') %><main class="public-page"><section class="page-hero"><div class="public-container"><span class="eyebrow light">Impact</span><h1>Recycling impact backed by platform records.</h1><p>ReLoop reports real collected and verified material. Environmental equivalents are only shown when the Owner configures a documented conversion factor.</p></div></section><section class="public-section"><div class="public-container"><div class="impact-hero-card"><strong><%= total.toLocaleString() %> kg</strong><span>Verified / completed material recorded by ReLoop</span><% if(estimatedCo2!==null){ %><div class="estimate"><b><%= estimatedCo2.toFixed(1) %> kg CO₂e</b><span>Estimated avoided impact*</span></div><% } %></div><div class="card"><h2>Material breakdown</h2><div class="bar-list"><% breakdown.forEach(b=>{ %><div><div class="bar-label"><span><%= b.name %></span><strong><%= Number(b.weight||0).toFixed(1) %> kg</strong></div><div class="bar-track"><span style="width:<%= total>0?Math.max(2,Number(b.weight||0)/total*100):0 %>%"></span></div></div><% }) %></div></div><% if(estimatedCo2!==null){ %><p class="fineprint">* <%= impactNote %></p><% } %></div></section></main><%- include('../partials/foot') %>
