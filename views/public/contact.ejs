<%- include('../partials/head',{title:'Contact & Support'}) %><%- include('../partials/public-nav') %><main class="public-page"><section class="page-hero"><div class="public-container"><span class="eyebrow light">Support</span><h1>How can ReLoop help?</h1></div></section><section class="public-section"><div class="public-container narrow"><div class="card form-card"><% if(sent){ %><div class="alert success">Your message was received and added to the ReLoop support queue.</div><% } %><% if(typeof error!=='undefined'&&error){ %><div class="alert danger"><%= error %></div><% } %><form method="post" action="/contact" class="form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Name<input name="name"></label><label>Email<input type="email" name="email"></label><label class="full">Subject<input name="subject" required></label><label class="full">Message<textarea name="message" required></textarea></label><div class="full"><button class="btn primary">Send support request</button></div></form></div></div></section></main><%- include('../partials/foot') %>
