<%- include('../partials/head',{title:'Recycle smarter'}) %><%- include('../partials/public-nav') %><main><section class="public-hero"><div class="public-container hero-grid"><div><span class="eyebrow light">Uganda-ready circular economy platform</span><h1>Make recycling easier from pickup to verified delivery.</h1><p>ReLoop connects customers, collectors and recycling partners in one traceable platform — with clear status updates, verified weights and accountable operations.</p><div class="hero-actions"><a class="btn primary large" href="/recycle">Request a Pickup</a><a class="btn light large" href="/how-it-works">How It Works</a></div><div class="hero-links"><a href="/become-collector">Become a Collector →</a><a href="/become-partner">Become a Recycling Partner →</a></div></div><div class="hero-visual"><div class="loop-card"><div class="loop-icon">♻</div><h3>Customer → Collector → Partner</h3><p>One traceable recycling journey.</p><div class="mini-steps"><span>Request</span><span>Collect</span><span>Verify</span><span>Recycle</span></div></div></div></div></section>
<section class="public-section"><div class="public-container"><div class="section-head center"><span class="eyebrow">Platform impact</span><h2>Real activity from ReLoop records</h2><p>We separate real platform data from optional environmental estimates.</p></div><div class="public-stats"><div><strong><%= stats.recycled.toLocaleString() %> kg</strong><span>Verified / completed material</span></div><div><strong><%= stats.completed %></strong><span>Completed pickups</span></div><div><strong><%= stats.collectors %></strong><span>Verified collectors</span></div><div><strong><%= stats.partners %></strong><span>Verified partners</span></div></div></div></section>
<section class="public-section alt"><div class="public-container"><div class="section-head"><span class="eyebrow">Materials</span><h2>What you can recycle</h2></div><div class="material-grid"><% categories.forEach(c=>{ %><article class="material-card"><div class="material-icon">♻</div><h3><%= c.name %></h3><p><%= c.description %></p><small>Unit: <%= c.unit %></small></article><% }) %></div><div class="section-cta"><a class="btn secondary" href="/materials">View all materials</a></div></div></section>
<section class="public-section"><div class="public-container"><div class="section-head center"><span class="eyebrow">Simple workflow</span><h2>From waste to verified recycling</h2></div><div class="steps-grid"><article><b>01</b><h3>Request pickup</h3><p>Tell ReLoop what material you have, the estimated weight and where to collect it.</p></article><article><b>02</b><h3>Collector assigned</h3><p>A verified collector accepts or is assigned to the job and updates the pickup status.</p></article><article><b>03</b><h3>Weight recorded</h3><p>Your estimate stays unchanged while the collector records collected weight separately.</p></article><article><b>04</b><h3>Partner delivery</h3><p>Material is delivered, verified and completed with a permanent status history.</p></article></div></div></section>
<% if(announcements.length){ %><section class="public-section alt"><div class="public-container"><div class="section-head"><span class="eyebrow">Announcements</span><h2>Latest from ReLoop</h2></div><div class="news-grid"><% announcements.forEach(a=>{ %><article class="card"><h3><%= a.title %></h3><p><%= a.body %></p><small><%= a.created_at %></small></article><% }) %></div></div></section><% } %>
<section class="cta-band"><div class="public-container cta-row"><div><h2>Ready to recycle?</h2><p>Create a pickup request and track the entire process from your dashboard.</p></div><a class="btn light large" href="/recycle">Recycle Now</a></div></section></main><%- include('../partials/foot') %>
