<%- include('../partials/head',{title:'Recycling Partners'}) %><%- include('../partials/public-nav') %><main class="public-page"><section class="page-hero"><div class="public-container"><span class="eyebrow light">Partners</span><h1>Verified recycling partners</h1><p>ReLoop partner organizations participate in the marketplace; they are not separate ReLoop tenants.</p></div></section><section class="public-section"><div class="public-container"><div class="news-grid"><% if(!partners.length){ %><div class="empty">No public partner profiles are available yet.</div><% } %><% partners.forEach(p=>{ %><article class="card"><span class="badge success">Verified</span><h3><%= p.business_name||p.name %></h3><p><%= p.profile_notes||'ReLoop recycling partner.' %></p><small><%= p.location||'' %></small></article><% }) %></div><div class="section-cta"><a class="btn secondary" href="/become-partner">Become a Recycling Partner</a></div></div></section></main><%- include('../partials/foot') %>
