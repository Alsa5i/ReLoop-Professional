<%- include('../partials/head',{title:'Materials We Accept'}) %><%- include('../partials/public-nav') %><main class="public-page"><section class="page-hero"><div class="public-container"><span class="eyebrow light">Materials</span><h1>Materials accepted on ReLoop</h1><p>Categories are managed by ReLoop and can change as collection capacity and partner availability grow.</p></div></section><section class="public-section"><div class="public-container"><div class="material-grid"><% categories.forEach(c=>{ %><article class="material-card"><div class="material-icon">♻</div><h3><%= c.name %></h3><p><%= c.description %></p><small>Standard unit: <%= c.unit %><% if(c.indicative_reward!=null){ %> · Indicative reward: <%= c.indicative_reward %> per <%= c.unit %><% } %></small></article><% }) %></div><div class="section-cta"><a class="btn primary" href="/recycle">Request a Pickup</a></div></div></section></main><%- include('../partials/foot') %>
