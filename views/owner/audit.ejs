<%- include('../partials/app-start',{title:'Audit Logs',page:'audit',heading:'Audit Logs',subheading:'Security and operational accountability'}) %><section class="card"><div class="table-wrap"><table><thead><tr><th>Time</th><th>User</th><th>Action</th><th>Entity</th><th>IP</th></tr></thead><tbody><% rows.forEach(a=>{ %><tr><td><%= a.created_at %></td><td><%= a.user_name||'System/public' %><small class="table-sub"><%= a.role||'' %></small></td><td><%= a.action %></td><td><%= a.entity_type||'—' %> <%= a.entity_id||'' %></td><td><%= a.ip||'—' %></td></tr><% }) %></tbody></table></div></section><%- include('../partials/pagination',{pages}) %><%- include('../partials/app-end') %>
