<%- include('../partials/app-start',{title:'Staff Performance',page:'staff-performance',heading:'Admin Activity',subheading:'Useful 30-day operational counts — not invasive surveillance or artificial scoring'}) %><section class="card"><div class="table-wrap"><table><thead><tr><th>Admin</th><th>Pickup actions</th><th>Verifications</th><th>Dispute actions</th><th>Support actions</th><th>Total logged actions</th></tr></thead><tbody><% if(!rows.length){ %><tr><td colspan="6">No Admin accounts yet.</td></tr><% } %><% rows.forEach(r=>{ %><tr><td><strong><%= r.name %></strong><small class="table-sub"><%= r.email %></small></td><td><%= r.pickup_actions||0 %></td><td><%= r.verifications||0 %></td><td><%= r.disputes||0 %></td><td><%= r.support_actions||0 %></td><td><%= r.total_actions||0 %></td></tr><% }) %></tbody></table></div><p class="fineprint">Counts reflect audited workflow actions in the last 30 days. ReLoop does not convert them into a meaningless employee score.</p></section><%- include('../partials/app-end') %>
