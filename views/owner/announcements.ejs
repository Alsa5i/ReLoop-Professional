<%- include('../partials/app-start',{title:'Announcements',page:'announcements',heading:'Announcements',subheading:'Publish controlled notices to the public ReLoop homepage'}) %><div class="two-col"><section class="card form-card"><h2>New announcement</h2><form method="post" action="/owner/announcements" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Title<input name="title" required></label><label>Body<textarea name="body" required></textarea></label><button class="btn primary">Publish</button></form></section><section class="card"><div class="list-stack"><% rows.forEach(a=>{ %><article class="list-row"><div><strong><%= a.title %></strong><p><%= a.body %></p><small><%= a.created_at %> · <%= a.created_by_name %></small></div><form method="post" action="/owner/announcements/<%= a.id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn small <%= a.active?'secondary':'primary' %>"><%= a.active?'Hide':'Publish' %></button></form></article><% }) %></div></section></div><%- include('../partials/app-end') %>
