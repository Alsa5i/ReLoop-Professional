<%- include('../partials/app-start',{title:'Platform Settings',page:'settings',heading:'Platform Settings',subheading:'Owner-only commercial rules and impact configuration'}) %><section class="card form-card"><% if(saved){ %><div class="alert success">Platform settings saved.</div><% } %><form method="post" action="/owner/settings" class="form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Commission percentage<input type="number" step="0.01" min="0" name="commission_percentage" value="<%= settings.commission_percentage||0 %>"></label><label>Fixed commission fee<input type="number" step="1" min="0" name="commission_fixed_fee" value="<%= settings.commission_fixed_fee||0 %>"></label><label>Minimum commission fee<input type="number" step="1" min="0" name="commission_minimum_fee" value="<%= settings.commission_minimum_fee||0 %>"></label><label>Currency<input name="payment_currency" value="<%= settings.payment_currency||'UGX' %>"></label><label>Payment mode<input value="manual_verification" disabled><input type="hidden" name="payment_mode" value="manual_verification"></label><label>Support email<input type="email" name="platform_support_email" value="<%= settings.platform_support_email||'' %>"></label><label>CO₂ estimate factor per kg<input type="number" step="0.0001" min="0" name="impact_co2_factor_per_kg" value="<%= settings.impact_co2_factor_per_kg||0 %>"></label><label class="full">Impact estimate note<textarea name="impact_note"><%= settings.impact_note||'' %></textarea></label><div class="full"><button class="btn primary">Save Settings</button></div></form><div class="alert warning">Live provider mode is intentionally unavailable in this package until real provider credentials, API adapters and verified webhook handling are implemented and tested.</div></section><%- include('../partials/app-end') %>
