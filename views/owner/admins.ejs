<%- include('../partials/app-start',{title:'Admins',page:'admins',heading:'Admin Accounts',subheading:'Only the Platform Owner can create ReLoop administrators'}) %><div class="two-col"><section class="card form-card"><h2>Create Admin</h2><% if(error){ %><div class="alert danger"><%= error %></div><% } %><form method="post" action="/owner/admins" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Name<input name="name" required></label><label>Email<input type="email" name="email" required></label><label>Temporary strong password<input type="password" name="password" minlength="12" required></label><button class="btn primary">Create Admin</button></form><p class="fineprint">Production Admin credentials should be delivered securely and changed according to your deployment policy.</p></section><section class="card"><h2>Existing Admins</h2><div class="list-stack"><% if(!rows.length){ %><div class="empty">No Admin accounts yet.</div><% } %><% rows.forEach(a=>{ %><div class="list-row"><div><strong><%= a.name %></strong><small><%= a.email %></small></div><span class="badge <%= a.status==='active'?'success':'danger' %>"><%= a.status %></span></div><% }) %></div></section></div><%- include('../partials/app-end') %>
