<%- include('../partials/app-start',{title:'Users',page:'users',heading:'Users',subheading:'Manage ReLoop participants without exposing Owner control'}) %><section class="card"><form class="filter-row" method="get"><input name="q" value="<%= filters.q %>" placeholder="Search name, email or phone"><select name="role"><option value="">All roles</option><% ['admin','collector','partner','customer'].forEach(r=>{ %><option value="<%= r %>" <%= filters.role===r?'selected':'' %>><%= r %></option><% }) %></select><select name="status"><option value="">All status</option><option <%= filters.status==='active'?'selected':'' %>>active</option><option <%= filters.status==='suspended'?'selected':'' %>>suspended</option></select><button class="btn secondary">Filter</button></form><div class="table-wrap"><table><thead><tr><th>User</th><th>Role</th><th>Verification</th><th>Status</th><th>Actions</th></tr></thead><tbody><% rows.forEach(u=>{ %><tr><td><strong><%= u.name %></strong><small class="table-sub"><%= u.email %> · <%= u.phone||'No phone' %></small></td><td><span class="badge"><%= u.role %></span></td><td><%= u.verification_status %></td><td><span class="badge <%= u.status==='active'?'success':'danger' %>"><%= u.status %></span></td><td><% if(u.role!=='owner'){ %><div class="inline-actions"><form method="post" action="/owner/users/<%= u.id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="status" value="<%= u.status==='active'?'suspended':'active' %>"><button class="btn small <%= u.status==='active'?'danger':'secondary' %>"><%= u.status==='active'?'Suspend':'Activate' %></button></form><% if(['collector','partner'].includes(u.role)&&u.verification_status!=='verified'){ %><form method="post" action="/owner/users/<%= u.id %>/verify"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="state" value="verified"><button class="btn small primary">Verify</button></form><% } %></div><% } %></td></tr><% }) %></tbody></table></div></section><%- include('../partials/pagination',{pages}) %><%- include('../partials/app-end') %>
