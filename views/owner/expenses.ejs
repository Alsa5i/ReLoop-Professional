<%- include('../partials/app-start',{title:'Expenses',page:'expenses',heading:'Expense Management',subheading:'Track ReLoop operating costs separately from GMV'}) %><div class="two-col"><section class="card form-card"><h2>Add expense</h2><form method="post" action="/owner/expenses" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Category<select name="category"><% ['fuel','vehicle maintenance','collection equipment','salaries','marketing','software','utilities','storage','administration','other'].forEach(c=>{ %><option><%= c %></option><% }) %></select></label><label>Amount (<%= currency %>)<input type="number" min="0.01" step="0.01" name="amount" required></label><label>Date<input type="date" name="expense_date" value="<%= new Date().toISOString().slice(0,10) %>" required></label><label>Description<textarea name="description"></textarea></label><button class="btn primary">Record Expense</button></form></section><section class="card"><h2>Expense history</h2><div class="table-wrap"><table><thead><tr><th>Date</th><th>Category</th><th>Amount</th><th>By</th></tr></thead><tbody><% rows.forEach(e=>{ %><tr><td><%= e.expense_date %></td><td><%= e.category %></td><td><%= currency %> <%= Number(e.amount).toLocaleString() %></td><td><%= e.created_by_name %></td></tr><% }) %></tbody></table></div></section></div><%- include('../partials/app-end') %>
