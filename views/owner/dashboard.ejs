<%- include('../partials/app-start',{title:'Owner Dashboard',page:'dashboard',heading:'Owner Dashboard',subheading:'Business, financial and operational control'}) %><div class="dashboard-quick-actions"><span class="dashboard-actions-label">RUN YOUR PLATFORM</span><a href="/admin/pickups">Review pickups →</a><a href="/owner/payments">Check payments →</a><a href="/owner/users">Manage users →</a><a href="/admin/support">Support queue →</a></div>
<section class="metric-grid owner-metrics"><article class="metric-card"><span>Total users</span><strong><%= metrics.users %></strong><small><%= metrics.newUsers %> new in 30 days</small></article><article class="metric-card"><span>Active collectors</span><strong><%= metrics.activeCollectors %></strong><small><%= metrics.customers %> customers</small></article><article class="metric-card"><span>Verified partners</span><strong><%= metrics.partners %></strong><small><%= metrics.completed %> completed pickups</small></article><article class="metric-card"><span>Recycling volume</span><strong><%= metrics.volume.toLocaleString() %> kg</strong><small>verified / completed</small></article><article class="metric-card"><span>GMV</span><strong><%= currency %> <%= metrics.gmv.toLocaleString() %></strong><small>Marketplace value, not ReLoop revenue</small></article><article class="metric-card"><span>ReLoop revenue</span><strong><%= currency %> <%= metrics.revenue.toLocaleString() %></strong><small>Paid commission / fees only</small></article><article class="metric-card"><span>Monthly net</span><strong><%= currency %> <%= metrics.net.toLocaleString() %></strong><small>Revenue <%= metrics.monthRevenue.toLocaleString() %> − provider fees <%= metrics.monthProviderFees.toLocaleString() %> − expenses <%= metrics.monthExpenses.toLocaleString() %></small></article><article class="metric-card"><span>Paid payouts</span><strong><%= currency %> <%= metrics.payouts.toLocaleString() %></strong><small>Collector + partner allocations from paid transactions</small></article><article class="metric-card"><span>Attention</span><strong><%= metrics.pendingPayments+metrics.disputes %></strong><small><%= metrics.pendingPayments %> pending payments · <%= metrics.disputes %> disputes</small></article></section>
<section class="card financial-trend"><div class="card-head"><div><h2>Revenue and marketplace value</h2><p>Actual paid payments by month. Marketplace value is not ReLoop revenue.</p></div><a class="btn secondary small" href="/owner/payments">View ledger →</a></div><div class="chart-key"><span><i class="legend-revenue"></i> ReLoop revenue</span><span><i class="legend-gmv"></i> Marketplace value</span></div><% const chartMax=Math.max(1,...monthly.map(m=>Number(m.gmv||0))); %><div class="financial-bars" role="img" aria-label="Monthly paid revenue compared to gross marketplace value"><% if(!monthly.length){ %><div class="empty">No paid transactions yet. The chart will show real transactions after payment verification.</div><% } %><% monthly.forEach(m=>{ %><div class="financial-bar-col"><div class="financial-bar-pair"><div class="financial-bar bar-gmv" style="height:<%= Math.max(0,Number(m.gmv||0)/chartMax*100) %>%" title="<%= m.month %> marketplace value: <%= currency %> <%= Number(m.gmv||0).toLocaleString() %>"></div><div class="financial-bar bar-revenue" style="height:<%= Math.max(0,Number(m.revenue||0)/chartMax*100) %>%" title="<%= m.month %> ReLoop revenue: <%= currency %> <%= Number(m.revenue||0).toLocaleString() %>"></div></div><small><%= m.month %></small></div><% }) %></div></section>
<div class="two-col"><section class="card"><div class="card-head"><div><h2>Monthly performance</h2><p>GMV and ReLoop revenue remain separate.</p></div></div><div class="table-wrap"><table><thead><tr><th>Month</th><th>GMV</th><th>ReLoop revenue</th></tr></thead><tbody><% if(!monthly.length){ %><tr><td colspan="3">No payment history yet.</td></tr><% } %><% monthly.forEach(m=>{ %><tr><td><%= m.month %></td><td><%= currency %> <%= Number(m.gmv||0).toLocaleString() %></td><td><%= currency %> <%= Number(m.revenue||0).toLocaleString() %></td></tr><% }) %></tbody></table></div></section><section class="card"><div class="card-head"><div><h2>Recent audit activity</h2><p>Latest privileged and operational actions.</p></div><a href="/owner/audit">Full log</a></div><div class="activity-list"><% if(!recent.length){ %><div class="empty">No privileged activity recorded yet.</div><% } %><% recent.forEach(a=>{ %><div><strong><%= a.action.replaceAll('_',' ') %></strong><span><%= a.entity_type||'system' %> <%= a.entity_id||'' %></span><small><%= a.created_at %></small></div><% }) %></div></section></div>
<%- include('../partials/app-end') %>
