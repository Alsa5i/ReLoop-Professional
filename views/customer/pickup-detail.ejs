<%- include('../partials/app-start',{title:pickup.reference,page:'dashboard',heading:pickup.reference,subheading:'Pickup tracking and recycling record'}) %><div class="detail-header"><div><span class="badge"><%= pickup.status %></span><h1><%= pickup.material_name||'Recyclable material' %></h1><p><%= pickup.address %><% if(pickup.area){ %> · <%= pickup.area %><% } %></p></div><img class="qr-small" src="/pickup/<%= pickup.id %>/qr.png" alt="Pickup verification QR"></div><div class="three-col"><section class="card"><h2>Weight record</h2><div class="weight-stack"><div><span>Your estimate</span><strong><%= pickup.estimated_weight??'—' %> kg</strong></div><div><span>Collector recorded</span><strong><%= pickup.collected_weight??'—' %> kg</strong></div><div><span>Final verified</span><strong><%= pickup.verified_weight??'—' %> kg</strong></div></div></section><section class="card"><h2>Collection</h2><div class="detail-list"><div><span>Collector</span><strong><%= pickup.collector_name||'Not assigned yet' %></strong></div><div><span>Partner</span><strong><%= pickup.partner_name||'Not assigned yet' %></strong></div><div><span>Preferred time</span><strong><%= pickup.preferred_time||'—' %></strong></div><div><span>Landmark</span><strong><%= pickup.landmark||'—' %></strong></div></div></section><section class="card"><h2>Actions</h2><% if(['pending','approved','assigned'].includes(pickup.status)){ %><form method="post" action="/customer/pickups/<%= pickup.id %>/cancel" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input name="notes" placeholder="Cancellation reason"><button class="btn danger">Cancel Pickup</button></form><% } else { %><p class="muted">For cancellation after collection has started, contact ReLoop support.</p><% } %><a class="btn secondary wide top-gap" href="/contact">Contact Support</a></section></div>
<section class="card"><h2>Status history</h2><div class="timeline compact"><% history.forEach(h=>{ %><article><span></span><div><h3><%= h.new_status %></h3><p><%= h.notes||'Status updated' %></p><small><%= h.created_at %></small></div></article><% }) %></div></section>
<div class="two-col"><section class="card"><h2>Payments</h2><div class="alert warning">ReLoop does not automatically mark payments as paid without external/manual verification.</div><% if(payments.length){ %><div class="list-stack"><% payments.forEach(p=>{ %><div class="list-row"><div><strong><%= p.reference %></strong><small><%= p.method %> · <%= currency %> <%= Number(p.gross_value).toLocaleString() %></small></div><span class="badge <%= p.status==='paid'?'success':p.status==='pending'?'warning':'danger' %>"><%= p.status %></span></div><% }) %></div><% } %><form method="post" action="/customer/pickups/<%= pickup.id %>/payment" class="form-grid top-gap"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Method<select name="method"><option value="mtn_momo">MTN MoMo</option><option value="airtel_money">Airtel Money</option><option value="card">Visa / Mastercard</option><option value="bank_transfer">Bank Transfer</option></select></label><label>Amount (<%= currency %>)<input type="number" min="1" step="1" name="amount" required></label><div class="full"><button class="btn secondary">Initiate Pending Payment</button></div></form></section><section class="card"><h2>Feedback & safety</h2><% if(pickup.status==='completed'&&!rating&&pickup.assigned_collector_id){ %><form method="post" action="/customer/pickups/<%= pickup.id %>/rate" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Rating<select name="stars"><option value="5">5 — Excellent</option><option value="4">4 — Good</option><option value="3">3 — Okay</option><option value="2">2 — Poor</option><option value="1">1 — Very poor</option></select></label><label>Review<textarea name="review"></textarea></label><button class="btn primary">Submit rating</button></form><% } else if(rating){ %><div class="alert success">Your rating: <b><%= rating.stars %>/5</b><br><%= rating.review||'' %></div><% } %><details><summary>Open a dispute</summary><form method="post" action="/customer/pickups/<%= pickup.id %>/dispute" class="form-stack top-gap"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Category<select name="category"><option>weight disagreement</option><option>payment problem</option><option>pickup issue</option><option>material quality</option><option>collector conduct</option><option>partner issue</option></select></label><label>Description<textarea name="description" required></textarea></label><button class="btn secondary">Open dispute</button></form></details><details><summary>Report a safety issue</summary><form method="post" action="/customer/pickups/<%= pickup.id %>/report" class="form-stack top-gap"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Category<select name="category"><option>fraud</option><option>harassment</option><option>suspicious transaction</option><option>inappropriate behavior</option><option>fake information</option></select></label><label>Description<textarea name="description" required></textarea></label><button class="btn danger">Submit report</button></form></details></section></div><%- include('../partials/app-end') %>
