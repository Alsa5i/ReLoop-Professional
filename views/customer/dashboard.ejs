<%- include('../partials/app-start',{title:'Customer Dashboard',page:'dashboard',heading:'My Recycling',subheading:'Track pickups, verified weights and your recycling history'}) %><div class="dashboard-quick-actions"><span class="dashboard-actions-label">YOUR NEXT STEP</span><a href="/customer/pickups/new">+ Request collection</a><a href="/customer/business">Business recycling →</a><a href="/support">Need assistance? →</a></div><section class="metric-grid"><article class="metric-card"><span>Material recycled</span><strong><%= metrics.recycled.toLocaleString() %> kg</strong></article><article class="metric-card"><span>Completed pickups</span><strong><%= metrics.completed %></strong></article><article class="metric-card"><span>Active pickups</span><strong><%= metrics.active %></strong></article><article class="metric-card"><span>Indicative rewards</span><strong><%= currency %> <%= metrics.rewards.toLocaleString() %></strong><small>Only where a material reward is configured</small></article></section><% if(estimatedCo2!==null){ %><div class="alert info">Estimated environmental impact: <b><%= estimatedCo2.toFixed(1) %> kg CO₂e avoided</b>. This is an estimate using the Owner-configured conversion factor.</div><% } %><section class="card"><div class="card-head"><div><h2>Recent pickups</h2><p>Your requests and their current status.</p></div><a class="btn primary" href="/customer/pickups/new">Request Pickup</a></div><div class="responsive-cards"><% if(!rows.length){ %><div class="empty">You have no pickup requests yet. <a href="/customer/pickups/new">Request your first pickup →</a></div><% } %><% rows.forEach(p=>{ %><a class="pickup-card" href="/customer/pickups/<%= p.id %>"><div><span class="badge"><%= p.status %></span><h3><%= p.material_name||'Material' %></h3><p><%= p.reference %> · <%= p.area||p.city||'Pickup location' %></p></div><div class="weight-mini"><span>Est. <b><%= p.estimated_weight??'—' %> kg</b></span><span>Verified <b><%= p.verified_weight??'—' %> kg</b></span></div></a><% }) %></div></section><%- include('../partials/app-end') %>
