<%- include('../partials/app-start',{title:'Request Pickup',page:'new-pickup',heading:'Request a Pickup',subheading:'Tell ReLoop what you have and where it should be collected'}) %><section class="card form-card"><% if(error){ %><div class="alert danger"><%= error %></div><% } %><form method="post" action="/customer/pickups" class="form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Material<select name="category_id" required><option value="">Choose material</option><% categories.forEach(c=>{ %><option value="<%= c.id %>"><%= c.name %> (<%= c.unit %>)</option><% }) %></select></label><label>Estimated weight (kg)<input type="number" step="0.01" min="0.01" name="estimated_weight" required></label><label class="full">Pickup address<input name="address" required placeholder="Street, building, plot or clear pickup description"></label><label>Area<input name="area" list="zones" placeholder="e.g. Kansanga"><datalist id="zones"><% zones.forEach(z=>{ %><option value="<%= z.name %>"><%= z.city %></option><% }) %></datalist></label><label>City<input name="city" placeholder="e.g. Kampala"></label><label>Landmark<input name="landmark"></label><label>Preferred time<input name="preferred_time" placeholder="e.g. Tomorrow afternoon"></label><label>Latitude <small>(optional / future maps)</small><input type="number" step="any" name="latitude"></label><label>Longitude <small>(optional / future maps)</small><input type="number" step="any" name="longitude"></label><label class="full">Pickup instructions / notes<textarea name="notes" placeholder="Access instructions, material condition, special notes"></textarea></label><div class="full"><div class="alert info">Your estimated weight is stored separately. The collector’s recorded weight and final verified weight will not overwrite it.</div><button class="btn primary large">Submit Pickup Request</button></div></form></section><%- include('../partials/app-end') %>
