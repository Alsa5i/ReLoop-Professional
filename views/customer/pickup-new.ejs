<%- include('../partials/app-start',{title:'Request Pickup',page:'new-pickup',heading:'Request a Pickup',subheading:'Tell ReLoop what you have and where it should be collected'}) %><section class="card form-card"><% if(error){ %><div class="alert danger"><%= error %></div><% } %><form method="post" action="/customer/pickups" class="form-grid"><h2 class="form-step"><span>1</span> What are we collecting?</h2><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Material<select name="category_id" required><option value="">Choose material</option><% categories.forEach(c=>{ %><option value="<%= c.id %>"><%= c.name %> (<%= c.unit %>)</option><% }) %></select></label><label>Estimated weight (kg)<small class="field-hint">An approximate weight is fine; the verified weight is recorded later.</small><input type="number" step="0.01" min="0.01" name="estimated_weight" required></label><h2 class="form-step"><span>2</span> Where should we collect it?</h2><label class="full">Pickup address<input name="address" required placeholder="Street, building, plot or clear pickup description"></label><label>Area<input name="area" list="zones" placeholder="e.g. Kansanga"><datalist id="zones"><% zones.forEach(z=>{ %><option value="<%= z.name %>"><%= z.city %></option><% }) %></datalist></label><label>City<input name="city" placeholder="e.g. Kampala"></label><label>Landmark <small class="field-hint">Helps collectors find your location.</small><input name="landmark"></label><h2 class="form-step"><span>3</span> When and how?</h2><label>Preferred time<input name="preferred_time" placeholder="e.g. Tomorrow afternoon"></label><details class="form-advanced"><summary>Advanced: map coordinates (optional)</summary><p class="field-hint">No GPS service is connected. Leave these blank unless you know the coordinates.</p><div class="form-grid"><label>Latitude<input type="number" step="any" name="latitude"></label><label>Longitude<input type="number" step="any" name="longitude"></label></div></details><label class="full">Pickup instructions / notes<textarea name="notes" placeholder="Access instructions, material condition, special notes"></textarea></label><div class="full"><div class="alert info">Your estimated weight is stored separately. The collector’s recorded weight and final verified weight will not overwrite it.</div><div class="pickup-submit-bar"><p class="inline-note">You can track every status update after you submit. No payment is taken when creating this request.</p><button class="btn primary large">Submit Pickup Request →</button></div></div></form></section><%- include('../partials/app-end') %>
