<%- include('../partials/app-start',{title:'Business recycling',page:'business',heading:'Business recycling',subheading:'Use one ReLoop customer account for your business'}) %>
<section class="card form-card"><h2>Business profile</h2><form method="post" action="/customer/business" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Business name<input required name="business_name" value="<%= business?.business_name||'' %>"></label><label>Contact person<input name="contact_person" value="<%= business?.contact_person||'' %>"></label><button class="btn primary">Save business profile</button></form></section>
<section class="card form-card"><h2>Your collection locations</h2><form method="post" action="/customer/business/locations" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Location label<input name="label" required placeholder="Main office"></label><label>Address<input name="address" required></label><label>Area<input name="area"></label><label>City<input name="city"></label><label>Landmark<input name="landmark"></label><button class="btn primary">Add location</button></form><ul><% locations.forEach(l=>{ %><li><%= l.label %> — <%= l.address %></li><% }) %></ul></section>
<% if(business&&locations.length){ %><section class="card form-card"><h2>Recurring pickup</h2><p>Internet is required; each occurrence becomes an independently tracked pickup when due. ReLoop must be running or the generation command must run.</p><form method="post" action="/customer/business/schedules" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Location<select name="location_id"><% locations.forEach(l=>{ %><option value="<%= l.id %>"><%= l.label %></option><% }) %></select></label><label>Material<select name="category_id"><% categories.forEach(c=>{ %><option value="<%= c.id %>"><%= c.name %></option><% }) %></select></label><label>Estimated kg<input name="estimated_weight" type="number" step="0.01" min="0.01" required></label><label>Frequency<select name="frequency"><option value="weekly">Weekly</option><option value="biweekly">Every 2 weeks</option><option value="monthly">Monthly</option></select></label><label>First date<input type="date" name="next_date" required></label><button class="btn primary">Create schedule</button></form></section><section class="card"><h2>Your schedules</h2><% schedules.forEach(s=>{ %><div class="list-row"><div><strong><%= s.material %> · <%= s.label %></strong><small><%= s.frequency %> · Next <%= s.next_date %> · <%= s.active?'Active':'Stopped' %></small></div><% if(s.active){ %><form method="post" action="/customer/business/schedules/<%= s.id %>/stop"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn secondary small">Stop</button></form><% } %></div><% }) %><a class="btn secondary" href="/customer/business/history.csv">Export recycling history CSV</a></section><% } %><%- include('../partials/app-end') %>