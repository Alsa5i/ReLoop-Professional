<%- include('../partials/app-start',{title:'Safety Reports',page:'safety',heading:'Safety & User Reports',subheading:'Fraud, harassment, suspicious transactions and inappropriate behavior'}) %><section class="card"><div class="list-stack"><% if(!rows.length){ %><div class="empty">No safety reports.</div><% } %><% rows.forEach(r=>{ %><article class="case-card"><div class="case-head"><div><span class="badge"><%= r.status %></span><h3><%= r.category %></h3><small>Reporter: <%= r.reporter_name %> · Reported: <%= r.reported_name||'Not specified' %> · Pickup: <%= r.pickup_reference||'—' %></small></div></div><p><%= r.description %></p><form method="post" action="/admin/safety/<%= r.id %>/status" class="inline-actions"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select name="status"><% ['open','investigating','resolved','rejected'].forEach(s=>{ %><option <%= r.status===s?'selected':'' %>><%= s %></option><% }) %></select><button class="btn small primary">Update</button></form></article><% }) %></div></section><%- include('../partials/app-end') %>
