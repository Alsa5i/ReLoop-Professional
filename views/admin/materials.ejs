<%- include('../partials/app-start',{title:'Materials',page:'materials',heading:'Material Categories',subheading:'Configurable recycling categories — not hard-coded into workflows'}) %><div class="two-col"><section class="card form-card"><h2>Add material</h2><form method="post" action="/admin/materials" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Name<input name="name" required></label><label>Description<textarea name="description"></textarea></label><label>Unit<input name="unit" value="kg"></label><label>Indicative reward per unit <small>(optional)</small><input type="number" step="0.01" min="0" name="indicative_reward"></label><button class="btn primary">Add Category</button></form></section><section class="card"><div class="list-stack"><% rows.forEach(m=>{ %><article class="list-row"><div><strong><%= m.name %></strong><p><%= m.description||'' %></p><small><%= m.unit %><% if(m.indicative_reward!=null){ %> · reward <%= m.indicative_reward %><% } %></small></div><form method="post" action="/admin/materials/<%= m.id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn small <%= m.active?'secondary':'primary' %>"><%= m.active?'Deactivate':'Activate' %></button></form></article><% }) %></div></section></div><%- include('../partials/app-end') %>
