<%- include('../partials/app-start',{title:pickup.reference,page:'pickups',heading:pickup.reference,subheading:'Full pickup traceability and operations'}) %><div class="detail-header"><div><span class="badge"><%= pickup.status %></span><h1><%= pickup.material_name||'Recyclable material' %></h1><p><%= pickup.customer_name %> · <%= pickup.customer_phone||'No phone' %></p></div><img class="qr-small" src="/pickup/<%= pickup.id %>/qr.png" alt="Pickup verification QR"></div><div class="three-col"><section class="card"><h2>Pickup</h2><div class="detail-list"><div><span>Address</span><strong><%= pickup.address %></strong></div><div><span>Area / city</span><strong><%= pickup.area||'—' %> / <%= pickup.city||'—' %></strong></div><div><span>Landmark</span><strong><%= pickup.landmark||'—' %></strong></div><div><span>Preferred time</span><strong><%= pickup.preferred_time||'—' %></strong></div><div><span>Notes</span><strong><%= pickup.notes||'—' %></strong></div></div></section><section class="card"><h2>Weight trail</h2><div class="weight-stack"><div><span>Customer estimate</span><strong><%= pickup.estimated_weight??'—' %> kg</strong></div><div><span>Collector recorded</span><strong><%= pickup.collected_weight??'—' %> kg</strong></div><div><span>Final verified</span><strong><%= pickup.verified_weight??'—' %> kg</strong></div></div><p class="fineprint">Original estimates are never silently overwritten.</p></section><section class="card"><h2>Assignment</h2><p><b>Collector:</b> <%= pickup.collector_name||'Unassigned' %></p><p><b>Partner:</b> <%= pickup.partner_name||'Not assigned' %></p><% if(['approved','assigned'].includes(pickup.status)){ %><form method="post" action="/admin/pickups/<%= pickup.id %>/assign" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Assign collector<select name="collector_id" required><option value="">Select</option><% collectors.forEach(c=>{ %><option value="<%= c.id %>"><%= c.name %> · <%= c.availability %> · ★<%= Number(c.rating||0).toFixed(1) %></option><% }) %></select></label><label class="check-row"><input type="checkbox" name="override_unavailable" value="1"> Admin override if selected collector is busy/offline</label><button class="btn secondary">Assign</button></form><% } %><form method="post" action="/admin/pickups/<%= pickup.id %>/partner" class="form-stack top-gap"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Recycling partner<select name="partner_id"><option value="">None</option><% partners.forEach(p=>{ %><option value="<%= p.id %>" <%= pickup.partner_id===p.id?'selected':'' %>><%= p.business_name %></option><% }) %></select></label><button class="btn secondary">Save partner</button></form></section></div>
<section class="card"><div class="card-head"><div><h2>Operational actions</h2><p>Actions respect the pickup status model.</p></div></div><div class="action-grid"><% if(pickup.status==='pending'){ %><form method="post" action="/admin/pickups/<%= pickup.id %>/approve"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input name="notes" placeholder="Approval note"><button class="btn primary">Approve Pickup</button></form><% } %><% if(pickup.status==='delivered'){ %><form method="post" action="/admin/pickups/<%= pickup.id %>/verify"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="number" step="0.01" min="0.01" name="verified_weight" placeholder="Verified kg" required><input name="verification_notes" placeholder="Verification notes"><button class="btn primary">Verify Weight</button></form><% } %><% if(pickup.status==='verified'){ %><form method="post" action="/admin/pickups/<%= pickup.id %>/complete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input name="notes" placeholder="Completion note"><button class="btn primary">Complete Pickup</button></form><% } %><% if(!['completed','cancelled','collected','delivered','verified'].includes(pickup.status)){ %><form method="post" action="/admin/pickups/<%= pickup.id %>/cancel"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input name="notes" placeholder="Cancellation reason"><button class="btn danger">Cancel Pickup</button></form><% } %></div></section>
<div class="two-col"><section class="card"><h2>Status history</h2><div class="timeline compact"><% history.forEach(h=>{ %><article><span></span><div><h3><%= h.new_status %></h3><p><%= h.notes||'Status updated' %></p><small><%= h.created_at %> · <%= h.changed_by_name %></small></div></article><% }) %></div></section><section class="card"><h2>Private collection proof</h2><div class="list-stack"><% if(!proofs.length){ %><div class="empty">No proof added yet.</div><% } %><% proofs.forEach(p=>{ %><div class="list-row"><div><strong><%= p.proof_type %></strong><small><%= p.notes||p.file_name||'Evidence' %> · <%= p.created_at %></small></div><% if(p.file_name){ %><a class="btn small secondary" href="/proof/<%= p.id %>" target="_blank">View</a><% } %></div><% }) %></div></section></div><%- include('../partials/app-end') %>
