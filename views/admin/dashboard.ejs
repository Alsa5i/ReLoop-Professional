<%- include('../partials/app-start',{title:'Admin Dashboard',page:'dashboard',heading:'Operations Dashboard',subheading:'Daily recycling operations from live SQLite data'}) %><section class="metric-grid"><article class="metric-card"><span>Pending pickups</span><strong><%= metrics.pending %></strong></article><article class="metric-card"><span>Active pickups</span><strong><%= metrics.active %></strong></article><article class="metric-card"><span>Completed today</span><strong><%= metrics.completedToday %></strong></article><article class="metric-card"><span>Collected weight</span><strong><%= metrics.weight.toLocaleString() %> kg</strong></article><article class="metric-card"><span>Collectors</span><strong><%= metrics.verifiedCollectors %></strong><small><%= metrics.pendingCollectors %> pending verification</small></article><article class="metric-card"><span>Partners</span><strong><%= metrics.verifiedPartners %></strong><small><%= metrics.pendingPartners %> pending verification</small></article><article class="metric-card"><span>Open disputes</span><strong><%= metrics.disputes %></strong></article><article class="metric-card"><span>Support queue</span><strong><%= metrics.support %></strong></article></section><section class="card"><div class="card-head"><div><h2>Recent pickups</h2><p>Latest customer requests and status changes.</p></div><a class="btn small secondary" href="/admin/pickups">Manage all</a></div><div class="table-wrap"><table><thead><tr><th>Reference</th><th>Customer</th><th>Material</th><th>Estimate</th><th>Status</th><th></th></tr></thead><tbody><% recent.forEach(p=>{ %><tr><td><strong><%= p.reference %></strong></td><td><%= p.customer_name %></td><td><%= p.material_name||'—' %></td><td><%= p.estimated_weight||'—' %> kg</td><td><span class="badge"><%= p.status %></span></td><td><a href="/admin/pickups/<%= p.id %>">Open →</a></td></tr><% }) %></tbody></table></div></section><%- include('../partials/app-end') %>
