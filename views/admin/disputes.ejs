<%- include('../partials/app-start',{title:'Disputes',page:'disputes',heading:'Disputes',subheading:'Weight, payment, pickup, quality and conduct issues'}) %><section class="card"><div class="list-stack"><% if(!rows.length){ %><div class="empty">No disputes.</div><% } %><% rows.forEach(d=>{ %><article class="case-card"><div class="case-head"><div><span class="badge"><%= d.status %></span><h3><%= d.category %> · <%= d.pickup_reference||'General' %></h3><small>Opened by <%= d.opened_by_name %> · <%= d.created_at %></small></div></div><p><%= d.description %></p><form method="post" action="/admin/disputes/<%= d.id %>" class="filter-row"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select name="status"><% ['open','investigating','resolved','rejected'].forEach(s=>{ %><option <%= d.status===s?'selected':'' %>><%= s %></option><% }) %></select><input name="resolution" value="<%= d.resolution||'' %>" placeholder="Resolution / investigation note"><button class="btn small primary">Update</button></form></article><% }) %></div></section><%- include('../partials/app-end') %>
