<%- include('../partials/app-start',{title:batch.batch_code,page:'batches',heading:batch.batch_code,subheading:'Batch traceability'}) %><div class="three-col"><section class="card"><span class="label">Material</span><h2><%= batch.material_name %></h2><p><b><%= Number(batch.total_weight||0).toFixed(1) %> kg</b> across <%= pickups.length %> pickup(s).</p></section><section class="card"><span class="label">Storage</span><h2><%= batch.storage_location||'Not set' %></h2><p>Partner: <%= batch.partner_name||'Not assigned' %></p></section><section class="card"><span class="label">Status</span><h2 class="capitalize"><%= batch.status %></h2><p>Created <%= batch.created_at %></p></section></div><div class="two-col"><section class="card"><h2>Add verified pickup</h2><% if(!eligible.length){ %><div class="empty">No eligible unbatched pickups for this material.</div><% } else { %><form method="post" action="/admin/batches/<%= batch.id %>/add-pickup" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Pickup<select name="pickup_id"><% eligible.forEach(p=>{ %><option value="<%= p.id %>"><%= p.reference %> · <%= p.customer_name %> · <%= Number(p.weight).toFixed(1) %> kg</option><% }) %></select></label><button class="btn primary">Add to Batch</button></form><% } %><h3 class="top-gap">Included pickups</h3><div class="list-stack"><% pickups.forEach(p=>{ %><div class="list-row"><div><strong><%= p.reference %></strong><small><%= p.customer_name %> · <%= p.status %></small></div><b><%= Number(p.weight).toFixed(1) %> kg</b></div><% }) %></div></section><section class="card"><h2>Batch operations</h2><form method="post" action="/admin/batches/<%= batch.id %>/update" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Status<select name="status"><% ['collecting','stored','sorted','ready','reserved','dispatched','delivered','completed'].forEach(s=>{ %><option <%= batch.status===s?'selected':'' %>><%= s %></option><% }) %></select></label><label>Storage location<input name="storage_location" value="<%= batch.storage_location||'' %>"></label><label>Partner<select name="partner_id"><option value="">Not assigned</option><% partners.forEach(p=>{ %><option value="<%= p.id %>" <%= batch.partner_id===p.id?'selected':'' %>><%= p.business_name %></option><% }) %></select></label><button class="btn primary">Update Batch</button></form></section></div><%- include('../partials/app-end') %>
