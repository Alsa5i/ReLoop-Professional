<%- include('../partials/app-start',{title:'Payments',page:'payments',heading:'Payment Review',subheading:'Manual verification is audited; paid status is never automatic without a real provider'}) %><section class="card"><form class="filter-row" method="get"><select name="status"><option value="">All statuses</option><% ['pending','paid','failed','cancelled','refunded'].forEach(s=>{ %><option value="<%= s %>" <%= status===s?'selected':'' %>><%= s %></option><% }) %></select><button class="btn secondary">Filter</button></form><div class="list-stack"><% if(!rows.length){ %><div class="empty">No payments found.</div><% } %><% rows.forEach(p=>{ %><article class="case-card"><div class="case-head"><div><span class="badge <%= p.status==='paid'?'success':p.status==='pending'?'warning':'danger' %>"><%= p.status %></span><h3><%= p.reference %></h3><small><%= p.payer_name||'Unknown payer' %> · Pickup <%= p.pickup_reference||'—' %> · <%= p.method %></small></div><div><strong><%= currency %> <%= Number(p.gross_value).toLocaleString() %></strong><small class="table-sub">Commission: <%= currency %> <%= Number(p.reloop_commission).toLocaleString() %></small></div></div><form method="post" action="/admin/payments/<%= p.id %>/verify" class="form-grid top-gap"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Status<select name="status"><% ['pending','paid','failed','cancelled','refunded'].forEach(s=>{ %><option <%= p.status===s?'selected':'' %>><%= s %></option><% }) %></select></label><label>Provider reference<input name="provider_reference" value="<%= p.provider_reference||'' %>"></label><label>Provider fee<input type="number" min="0" step="0.01" name="payment_provider_fee" value="<%= p.payment_provider_fee||0 %>"></label><label>Collector payout<input type="number" min="0" step="0.01" name="collector_payout" value="<%= p.collector_payout||0 %>"></label><label>Partner payout<input type="number" min="0" step="0.01" name="partner_payout" value="<%= p.partner_payout||0 %>"></label><label>Verification note<input name="verification_note" placeholder="Required when marking paid"></label><div class="full"><button class="btn primary">Save Payment Review</button></div></form></article><% }) %></div></section><%- include('../partials/pagination',{pages}) %><%- include('../partials/app-end') %>
