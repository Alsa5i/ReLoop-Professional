<%- include('../partials/app-start',{title:'Recycling campaigns',page:'campaigns',heading:'Recycling campaigns',subheading:'Sponsored programs with real tracked volumes'}) %><section class="card form-card"><h2>New campaign</h2><form method="post" action="/admin/campaigns" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Title<input name="title" required></label><label>Sponsor<input name="sponsor"></label><label>Location<input name="location"></label><label>Target kg<input name="target_kg" type="number" min="0.01" step="0.01" required></label><label>Material<select name="category_id"><option value="">All types</option><% categories.forEach(c=>{ %><option value="<%= c.id %>"><%= c.name %></option><% }) %></select></label><label>Start<input name="starts_at" type="date"></label><label>End<input name="ends_at" type="date"></label><label>Description<textarea name="description"></textarea></label><button class="btn primary">Create campaign</button></form></section><section class="card"><h2>Programs &amp; progress</h2><% rows.forEach(c=>{ %><div class="list-row"><div><strong><%= c.title %></strong><small><%= c.sponsor||'ReLoop' %> · <%= c.collected_kg %> / <%= c.target_kg %> kg verified</small></div><form method="post" action="/admin/campaigns/<%= c.id %>/pickups"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select name="pickup_id"><% pickups.filter(p=>!c.category_id||p.category_id===c.category_id).forEach(p=>{ %><option value="<%= p.id %>"><%= p.reference %> · <%= p.verified_weight %> kg</option><% }) %></select><button class="btn secondary small">Attribute pickup</button></form></div><% }) %></section><%- include('../partials/app-end') %>