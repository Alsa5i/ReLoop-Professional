<%- include('../partials/app-start',{title:'Pickups',page:'pickups',heading:'Pickup Operations',subheading:'Review, assign, track and verify recycling pickups'}) %><section class="card"><form class="filter-row" method="get"><input name="q" value="<%= filters.q %>" placeholder="Reference, customer, area, material"><select name="status"><option value="">All statuses</option><% ['pending','approved','assigned','accepted','en_route','arrived','collected','delivered','verified','completed','cancelled'].forEach(s=>{ %><option value="<%= s %>" <%= filters.status===s?'selected':'' %>><%= s %></option><% }) %></select><button class="btn secondary">Filter</button></form><div class="table-wrap"><table><thead><tr><th>Reference</th><th>Customer</th><th>Material</th><th>Weights</th><th>Area</th><th>Collector</th><th>Status</th><th></th></tr></thead><tbody><% rows.forEach(p=>{ %><tr><td><strong><%= p.reference %></strong><small class="table-sub"><%= p.requested_at %></small></td><td><%= p.customer_name %></td><td><%= p.material_name||'—' %></td><td><small>Est: <%= p.estimated_weight??'—' %></small><br><small>Col: <%= p.collected_weight??'—' %></small><br><small>Ver: <%= p.verified_weight??'—' %></small></td><td><%= p.area||p.city||'—' %></td><td><%= p.collector_name||'Unassigned' %></td><td><span class="badge"><%= p.status %></span></td><td><a class="btn small secondary" href="/admin/pickups/<%= p.id %>">Open</a></td></tr><% }) %></tbody></table></div></section><%- include('../partials/pagination',{pages}) %><%- include('../partials/app-end') %>
