<%- include('../partials/app-start',{title:'Public content',page:'content',heading:'Public content',subheading:'Editable FAQ and information pages'}) %><section class="card form-card"><h2>Edit public text</h2><form action="/admin/content" method="post" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Content key<input name="content_key" required placeholder="faq_collection"></label><label>Title<input name="title" required></label><label>Text<textarea name="body" required rows="5"></textarea></label><button class="btn primary">Save content</button></form></section><section class="card"><h2>Saved content</h2><% rows.forEach(c=>{ %><div class="list-row"><div><strong><%= c.title %> (<%= c.content_key %>)</strong><p><%= c.body %></p></div></div><% }) %></section><%- include('../partials/app-end') %>