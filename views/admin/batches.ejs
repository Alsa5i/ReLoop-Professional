<%- include('../partials/app-start',{title:'Material Batches',page:'batches',heading:'Material Batches',subheading:'Combine verified material while preserving pickup traceability'}) %><div class="two-col"><section class="card form-card"><h2>Create batch</h2><form method="post" action="/admin/batches" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Material<select name="category_id" required><option value="">Choose material</option><% categories.forEach(c=>{ %><option value="<%= c.id %>"><%= c.name %></option><% }) %></select></label><label>Storage location<input name="storage_location"></label><label>Partner <small>(optional)</small><select name="partner_id"><option value="">Not assigned</option><% partners.forEach(p=>{ %><option value="<%= p.id %>"><%= p.business_name %></option><% }) %></select></label><button class="btn primary">Create Batch</button></form></section><section class="card"><div class="list-stack"><% if(!rows.length){ %><div class="empty">No material batches yet.</div><% } %><% rows.forEach(b=>{ %><a class="list-row" href="/admin/batches/<%= b.id %>"><div><strong><%= b.batch_code %></strong><small><%= b.material_name %> · <%= Number(b.total_weight||0).toFixed(1) %> kg · <%= b.pickup_count %> pickups</small><p><%= b.storage_location||'No storage location' %> · <%= b.partner_name||'No partner assigned' %></p></div><span class="badge"><%= b.status %></span></a><% }) %></div></section></div><%- include('../partials/app-end') %>
