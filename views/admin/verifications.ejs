<%- include('../partials/app-start',{title:'Verifications',page:'verifications',heading:'Verification Queue',subheading:'Manual verification until real verification services are connected'}) %><div class="two-col"><section class="card"><h2>Collectors</h2><div class="list-stack"><% if(!collectors.length){ %><div class="empty">No collector applications pending.</div><% } %><% collectors.forEach(c=>{ %><article class="list-row"><div><strong><%= c.name %></strong><small><%= c.email %> · <%= c.phone||'No phone' %></small><p><%= c.service_area||'No service area' %> · <%= c.vehicle_type||'Vehicle not set' %></p><small class="table-sub">Private verification: ID ref <%= c.id_reference||'Not supplied' %> · Emergency contact <%= c.emergency_contact||'Not supplied' %></small></div><div class="inline-actions"><form method="post" action="/admin/verifications/<%= c.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="state" value="verified"><button class="btn small primary">Verify</button></form><form method="post" action="/admin/verifications/<%= c.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="state" value="rejected"><button class="btn small danger">Reject</button></form></div></article><% }) %></div></section><section class="card"><h2>Partners</h2><div class="list-stack"><% if(!partners.length){ %><div class="empty">No partner applications pending.</div><% } %><% partners.forEach(p=>{ %><article class="list-row"><div><strong><%= p.business_name||p.name %></strong><small><%= p.email %> · <%= p.phone||'No phone' %></small><p><%= p.location||'No location' %> · Reg: <%= p.registration_info||'Not supplied' %></p></div><div class="inline-actions"><form method="post" action="/admin/verifications/<%= p.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="state" value="verified"><button class="btn small primary">Verify</button></form><form method="post" action="/admin/verifications/<%= p.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="state" value="rejected"><button class="btn small danger">Reject</button></form></div></article><% }) %></div></section></div><%- include('../partials/app-end') %>
