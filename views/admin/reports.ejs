<%- include('../partials/app-start',{title:'Reports',page:'reports',heading:'Pickup Reports',subheading:'Filterable operational reports with CSV export and print support'}) %><section class="card"><form class="filter-row" method="get"><input type="date" name="from" value="<%= filters.from %>"><input type="date" name="to" value="<%= filters.to %>"><select name="status"><option value="">All statuses</option><% ['pending','approved','assigned','accepted','en_route','arrived','collected','delivered','verified','completed','cancelled'].forEach(s=>{ %><option value="<%= s %>" <%= filters.status===s?'selected':'' %>><%= s %></option><% }) %></select><select name="material"><option value="">All materials</option><% categories.forEach(c=>{ %><option value="<%= c.id %>" <%= String(filters.material)===String(c.id)?'selected':'' %>><%= c.name %></option><% }) %></select><button class="btn secondary">Apply</button><a class="btn secondary" href="/admin/reports/pickups.csv">CSV</a><button class="btn secondary" type="button" onclick="window.print()">Print</button></form><div class="table-wrap printable"><table><thead><tr><th>Reference</th><th>Date</th><th>Material</th><th>Customer</th><th>Collector</th><th>Partner</th><th>Est.</th><th>Collected</th><th>Verified</th><th>Status</th></tr></thead><tbody><% rows.forEach(r=>{ %><tr><td><%= r.reference %></td><td><%= r.requested_at %></td><td><%= r.material_name||'—' %></td><td><%= r.customer_name %></td><td><%= r.collector_name||'—' %></td><td><%= r.partner_name||'—' %></td><td><%= r.estimated_weight??'—' %></td><td><%= r.collected_weight??'—' %></td><td><%= r.verified_weight??'—' %></td><td><%= r.status %></td></tr><% }) %></tbody></table></div></section><%- include('../partials/app-end') %>
