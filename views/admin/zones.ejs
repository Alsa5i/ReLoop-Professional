<%- include('../partials/app-start',{title:'Service Zones',page:'zones',heading:'Service Zones',subheading:'Configurable collection coverage — never hard-code a single city'}) %><div class="two-col"><section class="card form-card"><h2>Add zone</h2><form method="post" action="/admin/zones" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Zone / area<input name="name" required></label><label>City<input name="city" required></label><label>Pickup fee (<%= currency %>)<input type="number" min="0" step="1" name="pickup_fee" value="0"></label><label>Estimated service time<input name="estimated_service_time" placeholder="e.g. Same day"></label><button class="btn primary">Add Zone</button></form></section><section class="card"><div class="list-stack"><% if(!rows.length){ %><div class="empty">No service zones configured yet. Text addresses still work.</div><% } %><% rows.forEach(z=>{ %><article class="list-row"><div><strong><%= z.name %>, <%= z.city %></strong><small><%= currency %> <%= Number(z.pickup_fee).toLocaleString() %> · <%= z.estimated_service_time||'No ETA' %></small></div><form method="post" action="/admin/zones/<%= z.id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn small <%= z.active?'secondary':'primary' %>"><%= z.active?'Disable':'Enable' %></button></form></article><% }) %></div></section></div><%- include('../partials/app-end') %>
