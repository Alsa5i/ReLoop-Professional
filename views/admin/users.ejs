<%- include('../partials/app-start',{title:'Users',page:'users',heading:'Participant Management',subheading:'Admins may manage customers, collectors and partners — not Owner/Admin accounts'}) %><section class="card"><form class="filter-row" method="get"><input name="q" value="<%= filters.q %>" placeholder="Search name, email or phone"><select name="role"><option value="">All participant roles</option><% ['collector','partner','customer'].forEach(r=>{ %><option value="<%= r %>" <%= filters.role===r?'selected':'' %>><%= r %></option><% }) %></select><select name="status"><option value="">All statuses</option><option value="active" <%= filters.status==='active'?'selected':'' %>>active</option><option value="suspended" <%= filters.status==='suspended'?'selected':'' %>>suspended</option></select><button class="btn secondary">Filter</button></form><div class="table-wrap"><table><thead><tr><th>User</th><th>Role</th><th>Verification</th><th>Status</th><th>Action</th></tr></thead><tbody><% rows.forEach(u=>{ %><tr><td><strong><%= u.name %></strong><small class="table-sub"><%= u.email %> · <%= u.phone||'No phone' %></small></td><td><span class="badge"><%= u.role %></span></td><td><%= u.verification_status %></td><td><span class="badge <%= u.status==='active'?'success':'danger' %>"><%= u.status %></span></td><td><form method="post" action="/admin/users/<%= u.id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="status" value="<%= u.status==='active'?'suspended':'active' %>"><button class="btn small <%= u.status==='active'?'danger':'secondary' %>"><%= u.status==='active'?'Suspend':'Activate' %></button></form></td></tr><% }) %></tbody></table></div></section><%- include('../partials/pagination',{pages}) %><%- include('../partials/app-end') %>
