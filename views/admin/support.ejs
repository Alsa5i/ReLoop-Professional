<%- include('../partials/app-start',{title:'Support',page:'support',heading:'Support Queue',subheading:'Customer and public support requests'}) %><section class="card"><div class="list-stack"><% if(!rows.length){ %><div class="empty">Support queue is clear.</div><% } %><% rows.forEach(s=>{ %><article class="case-card"><div class="case-head"><div><span class="badge"><%= s.status %></span><h3><%= s.subject %></h3><small><%= s.user_name||s.name||'Public visitor' %> · <%= s.email||'No email' %> · <%= s.created_at %></small></div></div><p><%= s.message %></p><form method="post" action="/admin/support/<%= s.id %>/status" class="inline-actions"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select name="status"><% ['open','in_progress','resolved'].forEach(x=>{ %><option <%= s.status===x?'selected':'' %>><%= x %></option><% }) %></select><button class="btn small primary">Update</button></form><% if(user.role==='admin'&&!s.escalated){ %><form method="post" action="/admin/support/<%= s.id %>/escalate"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn small secondary">Escalate to Owner</button></form><% } %></article><% }) %></div></section><%- include('../partials/app-end') %>
