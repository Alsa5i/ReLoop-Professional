<header class="app-topbar"><button class="menu-toggle" type="button" onclick="document.getElementById('appSidebar').classList.toggle('open')">☰</button><div><strong><%= typeof heading!=='undefined'?heading:'ReLoop' %></strong><small><%= typeof subheading!=='undefined'?subheading:'' %></small></div><div class="topbar-user"><a href="/notifications" aria-label="Notifications">🔔<% if(unreadNotifications){ %><span class="notif-dot"><%= unreadNotifications %></span><% } %></a><span class="avatar"><%= user.name.charAt(0).toUpperCase() %></span><div><b><%= user.name %></b><small><%= user.role %></small></div></div></header>
