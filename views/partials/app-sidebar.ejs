<%
const root='/'+user.role;
const navByRole={
 owner:[
  {title:'OVERVIEW',links:[['Overview','/owner','home'],['Operations dashboard','/admin','activity']]},
  {title:'OPERATIONS',links:[['Pickup requests','/admin/pickups','truck'],['Verification queue','/admin/verifications','check'],['Materials & batches','/admin/batches','layers'],['Materials accepted','/admin/materials','recycle'],['Service zones','/admin/zones','map']]},
  {title:'PEOPLE & FINANCE',links:[['Customers & workers','/owner/users','users'],['Admin accounts','/owner/admins','shield'],['Payments','/owner/payments','wallet'],['Expenses','/owner/expenses','receipt'],['Reports','/admin/reports','chart']]},
  {title:'EXPERIENCE',links:[['Public content','/admin/content','edit'],['Campaigns','/admin/campaigns','flag'],['Announcements','/owner/announcements','bell']]},
  {title:'CONTROL & TRUST',links:[['Disputes','/admin/disputes','alert'],['Safety reports','/admin/safety','shield'],['Support inbox','/admin/support','help'],['Staff activity','/owner/staff-performance','activity'],['Audit log','/owner/audit','list'],['Platform settings','/owner/settings','settings'],['Legacy records','/legacy','archive']]}
 ],
 admin:[
  {title:'OVERVIEW',links:[['Operations dashboard','/admin','home']]},
  {title:'COLLECTIONS',links:[['Pickup requests','/admin/pickups','truck'],['Verification queue','/admin/verifications','check'],['Material batches','/admin/batches','layers'],['Materials accepted','/admin/materials','recycle'],['Service zones','/admin/zones','map']]},
  {title:'MANAGEMENT',links:[['Users','/admin/users','users'],['Payments','/admin/payments','wallet'],['Reports','/admin/reports','chart']]},
  {title:'CUSTOMER CARE',links:[['Support inbox','/admin/support','help'],['Disputes','/admin/disputes','alert'],['Safety reports','/admin/safety','shield']]},
  {title:'WEBSITE',links:[['Public content','/admin/content','edit'],['Campaigns','/admin/campaigns','flag'],['Legacy records','/legacy','archive']]}
 ],
 customer:[{title:'RECYCLING',links:[['My dashboard','/customer','home'],['Request a pickup','/customer/pickups/new','plus'],['Business & recurring','/customer/business','building']]}],
 collector:[{title:'MY WORK',links:[['Job dashboard','/collector','home'],['Collection history','/collector/history','truck'],['My earnings','/collector/earnings','wallet']]}],
 partner:[{title:'MY FACILITY',links:[['Partner dashboard','/partner','home'],['Delivery history','/partner/history','truck'],['Transactions','/partner/transactions','wallet'],['Business profile','/partner/profile','building']]}]
};
const groups=(navByRole[user.role]||[]).concat([{title:'MY ACCOUNT',links:[['Notifications','/notifications','bell'],['My profile','/profile','user'],['Devices & security','/account/devices','shield'],['Support center','/support','help'],['Install on phone','/install','globe'],['Public website','/','globe']]}]);
const isCurrent=href=>href==='/'?currentPath==='/':href==='/owner'||href==='/admin'||href==='/customer'||href==='/collector'||href==='/partner'?currentPath===href:currentPath===href||currentPath.startsWith(href+'/');
%>
<aside class="app-sidebar" id="appSidebar" aria-label="Workspace navigation">
 <a class="app-brand" href="<%= root %>" title="ReLoop dashboard">
  <span class="brand-logo" aria-hidden="true"><svg class="ui-icon"><use href="/icons/ui.svg#recycle"></use></svg></span>
  <span class="brand-copy"><strong>ReLoop<span class="brand-dot">.</span></strong><small><%= user.role==='owner'?'Owner workspace':user.role==='admin'?'Operations workspace':user.role.charAt(0).toUpperCase()+user.role.slice(1)+' workspace' %></small></span>
 </a>
 <div class="sidebar-caption"><span class="online-pulse" aria-hidden="true"></span> CENTRAL PLATFORM</div>
 <nav class="app-menu" aria-label="Primary">
 <% groups.forEach(group=>{ %><div class="nav-group"><p class="nav-group-title"><%= group.title %></p>
 <% group.links.forEach(item=>{const active=isCurrent(item[1]);%>
 <a href="<%= item[1] %>" data-nav-link class="nav-link <%= active?'active':'' %>" aria-current="<%= active?'page':'false' %>" title="<%= item[0] %>">
  <svg class="ui-icon" aria-hidden="true"><use href="/icons/ui.svg#<%= item[2] %>"></use></svg><span class="nav-label"><%= item[0] %></span>
  <% if(item[1]==='/notifications'&&unreadNotifications){%><span class="nav-count"><%= unreadNotifications %></span><%}%>
 </a><% }) %></div><% }) %>
 </nav>
 <div class="sidebar-bottom">
 <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="sidebar-signout" title="Sign out"><svg class="ui-icon" aria-hidden="true"><use href="/icons/ui.svg#logout"></use></svg><span class="nav-label">Sign out</span></button></form>
 </div>
</aside>