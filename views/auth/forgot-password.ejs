<%- include('../partials/head',{title:'Reset your password'}) %>
<a href="#resetForm" class="skip-link">Skip to password recovery</a>
<div class="access-layout"><aside class="access-story"><a class="access-wordmark" href="/"><span class="access-mark">♻</span> ReLoop.</a><div class="access-story-body"><span class="access-kicker">ACCOUNT SECURITY</span><h1>Get back to<br><em>recycling.</em></h1><p>Recover access to your ReLoop account without contacting a collector or sharing your password.</p></div><div class="access-story-foot">Reset links expire after 30 minutes and can only be used once.</div></aside>
<main class="access-main"><div class="access-mobile-brand"><a href="/" class="access-wordmark"><span class="access-mark">♻</span> ReLoop.</a></div><div class="access-main-top"><a class="access-back" href="/login">← Back to sign in</a><a href="/install">Install on your phone</a></div>
<div class="access-form-wrap"><span class="access-overline">SECURE ACCOUNT RECOVERY</span><h2>Forgot your password?</h2>
<% if(done){ %><div class="alert success" role="status">If this address has an eligible ReLoop account and email delivery is configured, a reset link has been sent. Check your inbox and spam folder.</div><a class="access-secondary" href="/login">Return to sign in →</a><% } else { %>
<p class="access-description">Enter your account email. The reset link can be used once and expires in 30 minutes.</p>
<% if(error){ %><div class="access-error" role="alert"><%= error %></div><% } %>
<% if(!mailConfigured){ %><p class="access-notice">Automatic password emails are not yet configured on this deployment. For help regaining access, <a href="/contact">contact ReLoop Support</a>.</p><% } %>
<form id="resetForm" class="access-form" method="post" action="/forgot-password"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label for="recoveryEmail">Email address</label><input id="recoveryEmail" type="email" name="email" maxlength="200" autocomplete="email" required placeholder="you@example.com"><button type="submit" class="access-submit">Request reset link →</button></form><% } %></div>
<footer class="access-footer"><span>ReLoop · One secure account</span><a href="/contact">Support</a></footer></main></div><script src="/js/app.js" defer></script></body></html>
