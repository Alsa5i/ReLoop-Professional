<%- include('../partials/head',{title:'Choose a new password'}) %>
<div class="access-layout"><aside class="access-story"><a class="access-wordmark" href="/"><span class="access-mark">♻</span> ReLoop.</a><div class="access-story-body"><span class="access-kicker">ACCOUNT SECURITY</span><h1>Welcome<br><em>back.</em></h1><p>A new password signs your other devices out, protecting access to your collection history.</p></div><div class="access-story-foot">ReLoop never asks you to share your password with collectors or partners.</div></aside>
<main class="access-main"><div class="access-mobile-brand"><a class="access-wordmark" href="/"><span class="access-mark">♻</span> ReLoop.</a></div><div class="access-main-top"><a class="access-back" href="/login">← Sign in</a><a href="/contact">Support</a></div><div class="access-form-wrap"><span class="access-overline">SECURE RESET</span><h2>Choose a new password</h2>
<% if(error){ %><div role="alert" class="access-error"><%= error %></div><% } %>
<% if(valid){ %><p class="access-description">Use at least 12 characters, then confirm your new password.</p><form class="access-form" method="post" action="/reset-password/<%= encodeURIComponent(token) %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label for="newPassword">New password</label><div class="access-password"><input id="newPassword" type="password" name="password" minlength="12" maxlength="200" required autocomplete="new-password"><button type="button" class="access-show" data-password-toggle="newPassword">Show</button></div><label for="confirmPassword">Confirm new password</label><div class="access-password"><input id="confirmPassword" type="password" name="password_confirmation" minlength="12" maxlength="200" required autocomplete="new-password"><button type="button" class="access-show" data-password-toggle="confirmPassword">Show</button></div><button type="submit" class="access-submit">Update password →</button></form>
<% } else { %><a class="access-secondary" href="/forgot-password">Request a new reset link →</a><% } %></div><footer class="access-footer"><span>ReLoop · Secure recycling</span></footer></main></div><script src="/js/app.js" defer></script></body></html>
