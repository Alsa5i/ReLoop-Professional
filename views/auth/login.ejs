<%- include('../partials/head',{title:'Sign in'}) %><div class="auth-shell"><div class="auth-brand-panel"><div class="auth-hero"><div class="brand-inline big">♻ <strong>ReLoop</strong></div><h1>Recycling operations, connected.</h1><p>Sign in to your customer, collector, partner or admin workspace.</p><a href="/" class="text-link">← Back to website</a></div></div><div class="auth-card-wrap"><form class="auth-card" method="post" action="/login"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><span class="eyebrow">Secure access</span><h2>Welcome back</h2><p class="muted">Owner accounts use the separate Owner portal.</p><% if(error){ %><div class="alert danger"><%= error %></div><% } %><label>Email<input type="email" name="email" autocomplete="email" required></label><label>Password<input type="password" name="password" autocomplete="current-password" required></label><button class="btn primary wide">Sign in</button><div class="auth-links"><a href="/register">Create customer account</a><a href="/owner/login">Owner login</a></div></form></div></div><script src="/js/app.js"></script></body></html>
