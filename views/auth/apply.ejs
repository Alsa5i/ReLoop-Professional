<%- include('../partials/head',{title:role==='collector'?'Become a Collector':'Become a Partner'}) %><div class="simple-page"><div class="narrow-card"><a href="/" class="brand-inline">♻ <strong>ReLoop</strong></a><span class="eyebrow"><%= role==='collector'?'Collector application':'Partner application' %></span><h1><%= role==='collector'?'Collect with ReLoop':'Join ReLoop as a recycling partner' %></h1><p class="muted">Applications are reviewed manually. ReLoop does not claim automatic identity or business verification.</p><% if(error){ %><div class="alert danger"><%= error %></div><% } %><form method="post" action="/apply/<%= role %>" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Your name<input name="name" required></label><label>Email<input type="email" name="email" required></label><label>Phone<input name="phone"></label><label><%= role==='collector'?'Service area':'Business / facility location' %><input name="area"></label><% if(role==='collector'){ %><label>Vehicle type<input name="vehicle_type" placeholder="e.g. motorcycle, van, bicycle"></label><label>ID reference <small>(kept private)</small><input name="id_reference"></label><label>Emergency contact <small>(kept private)</small><input name="emergency_contact"></label><% } %><% if(role==='partner'){ %><label>Business name<input name="business_name"></label><label>Registration information <small>(kept private)</small><input name="registration_info"></label><% } %><label>Password<input type="password" name="password" minlength="10" required></label><button class="btn primary wide">Submit application</button></form></div></div><script src="/js/app.js"></script></body></html>
