<%- include('../partials/head',{title:'Owner Login'}) %><div class="auth-shell"><div class="auth-brand-panel owner-panel"><div class="auth-hero"><div class="brand-inline big">♻ <strong>ReLoop Owner</strong></div><h1>Platform control center.</h1><p>This login is reserved for the ReLoop Platform Owner / Super Admin.</p><a href="/" class="text-link">← Back to website</a></div></div><div class="auth-card-wrap"><form class="auth-card" method="post" action="/owner/login"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><span class="eyebrow">Owner-only access</span><h2>Owner sign in</h2><% if(!configured){ %><div class="alert warning">No Owner account has been configured. Set OWNER_EMAIL and OWNER_PASSWORD in your .env file, then restart ReLoop.</div><% } %><% if(error){ %><div class="alert danger"><%= error %></div><% } %><label>Email<input type="email" name="email" autocomplete="email" required></label><label>Password<input type="password" name="password" autocomplete="current-password" required></label><button class="btn primary wide">Open Owner Dashboard</button></form></div></div><script src="/js/app.js"></script></body></html>
