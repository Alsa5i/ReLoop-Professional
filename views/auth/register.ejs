<%- include('../partials/head',{title:'Create your ReLoop account'}) %>
<a href="#createAccount" class="skip-link">Skip to account creation</a>
<div class="access-layout access-register">
  <aside class="access-story" aria-label="ReLoop community"><a href="/" class="access-wordmark"><span class="access-mark">♻</span><span>ReLoop<span class="brand-dot">.</span></span></a><div class="access-story-body"><span class="access-kicker">JOIN THE CIRCULAR ECONOMY</span><h1>Small actions.<br>Lasting<br><em>change.</em></h1><p>Create one ReLoop account. You can recycle at home, collect materials or join as a recycling facility.</p><div class="access-benefits"><span><b>01</b> Choose how you will use ReLoop</span><span><b>02</b> Create your secure account</span><span><b>03</b> Open your workspace right away</span></div></div><div class="access-story-foot">Collector and partner work privileges begin after manual verification.</div></aside>
  <main class="access-main"><div class="access-mobile-brand"><a href="/" class="access-wordmark"><span class="access-mark">♻</span> ReLoop<span class="brand-dot">.</span></a></div><div class="access-main-top"><a href="/" class="access-back">← Back to website</a><span>Already a member? <a class="strong-link" href="/login">Sign in</a></span></div>
    <div class="access-form-wrap"><span class="access-overline">GET STARTED</span><h2>Create your account</h2><p class="access-description">Select the type of account you need. Only the ReLoop owner can create administrator accounts.</p>
    <% if(error){ %><div class="access-error" role="alert"><strong>Check your details</strong><p><%= error %></p><% if(duplicate){ %><a class="strong-link" href="/login">Sign in to your existing account →</a><% } %></div><% } %>
    <form class="access-form" id="createAccount" method="post" action="/register" data-auth-form data-register-form>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="next" value="<%= next||'' %>">
      <fieldset class="account-roles"><legend>I want to…</legend>
        <label class="account-role"><input type="radio" name="role" value="customer" <%= role==='customer'?'checked':'' %>><span class="account-role-icon">♻</span><span><strong>Recycle materials</strong><small>Home or business pickup</small></span></label>
        <label class="account-role"><input type="radio" name="role" value="collector" <%= role==='collector'?'checked':'' %>><span class="account-role-icon">↗</span><span><strong>Collect materials</strong><small>Apply as a collector</small></span></label>
        <label class="account-role"><input type="radio" name="role" value="partner" <%= role==='partner'?'checked':'' %>><span class="account-role-icon">▣</span><span><strong>Receive materials</strong><small>Recycling facility/partner</small></span></label>
        <label class="account-role"><input type="radio" name="role" value="business" <%= role==='business'?'checked':'' %>><span class="account-role-icon">▤</span><span><strong>Recycle as a business</strong><small>Business pickups &amp; locations</small></span></label>
      </fieldset>
      <div class="access-two"><div><label for="regName">Full name</label><input id="regName" name="name" autocomplete="name" maxlength="120" value="<%= formData.name||'' %>" required placeholder="Your full name"></div><div><label for="regPhone">Phone <small>(optional)</small></label><input id="regPhone" name="phone" type="tel" autocomplete="tel" maxlength="40" value="<%= formData.phone||'' %>" placeholder="+256 7XX XXX XXX"></div></div>
      <label for="regEmail">Email address</label><input id="regEmail" name="email" type="email" autocomplete="email" spellcheck="false" autocapitalize="none" maxlength="200" value="<%= formData.email||'' %>" required placeholder="you@example.com">
      <div data-role-extra="business" class="access-conditional" <%= role==='business'?'':'hidden' %>><label for="regCustomerBusiness">Business name</label><input id="regCustomerBusiness" name="business_name" maxlength="180" value="<%= formData.business_name||'' %>" placeholder="Your company or organization"><p class="access-notice">A business account belongs to the same ReLoop platform. Add multiple collection locations after signing in.</p></div>
      <div data-role-extra="collector" class="access-conditional" <%= role==='collector'?'':'hidden' %>><label for="regArea">Service area</label><input id="regArea" name="area" maxlength="160" value="<%= formData.area||'' %>" placeholder="e.g. Kampala Central"><label for="regVehicle">Vehicle type <small>(optional)</small></label><input id="regVehicle" name="vehicle_type" maxlength="100" value="<%= formData.vehicle_type||'' %>" placeholder="Bicycle, motorcycle, van…"><p class="access-notice">Your account opens today. Accepting jobs requires ReLoop's manual collector verification.</p></div>
      <div data-role-extra="partner" class="access-conditional" <%= role==='partner'?'':'hidden' %>><label for="regBusiness">Business / facility name</label><input id="regBusiness" name="business_name" maxlength="180" value="<%= formData.business_name||'' %>" placeholder="Registered business or facility"><label for="regPartnerArea">Facility location</label><input id="regPartnerArea" name="area" maxlength="160" value="<%= formData.area||'' %>" placeholder="City and area"><p class="access-notice">Your partner workspace opens today. Full access follows manual verification.</p></div>
      <label for="regPassword">Create a password</label><div class="access-password"><input id="regPassword" name="password" type="password" minlength="12" autocomplete="new-password" spellcheck="false" autocapitalize="off" required placeholder="At least 12 characters"><button type="button" class="access-show" data-password-toggle="regPassword" aria-controls="regPassword" aria-pressed="false">Show</button></div><small class="access-field-hint">Use 12 or more characters. You can show the password to check it before submitting.</small>
      <label for="regPasswordConfirm">Confirm password</label><div class="access-password"><input id="regPasswordConfirm" name="password_confirmation" type="password" minlength="12" autocomplete="new-password" required placeholder="Re-enter your password"><button type="button" class="access-show" data-password-toggle="regPasswordConfirm" aria-controls="regPasswordConfirm" aria-pressed="false">Show</button></div>
      <button type="submit" class="access-submit"><span>Create account</span><span aria-hidden="true">→</span></button>
      <p class="access-legal">By creating an account you agree to ReLoop's <a href="/terms">Terms</a> and <a href="/privacy">Privacy Policy</a>.</p>
    </form>
    </div><footer class="access-footer"><span>© ReLoop · Better recycling, together</span><span><a href="/contact">Need help?</a> · <a href="/install">Install app</a></span></footer>
  </main>
</div><script src="/js/app.js"></script><script src="/js/enhancements.js"></script></body></html>
