<%- include('../partials/head',{title:'Create account'}) %><div class="simple-page"><div class="narrow-card"><a href="/" class="brand-inline">♻ <strong>ReLoop</strong></a><span class="eyebrow">Customer account</span><h1>Start recycling with ReLoop</h1><p class="muted">Request pickups, track collections and build your recycling history.</p><% if(error){ %><div class="alert danger"><%= error %></div><% } %><form method="post" action="/register" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="next" value="<%= next %>"><label>Full name<input name="name" required></label><label>Email<input type="email" name="email" required></label><label>Phone<input name="phone" placeholder="e.g. +256..."></label><label>Password<input type="password" name="password" minlength="10" required></label><button class="btn primary wide">Create account</button></form><p class="muted center">Collector? <a href="/become-collector">Apply here</a> · Recycling partner? <a href="/become-partner">Apply here</a></p></div></div><script src="/js/app.js"></script></body></html>
