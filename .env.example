NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
# BASE_URL is also accepted for backward compatibility
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
DB_PATH=./data.db

# OWNER_* provisions the first Owner. Changing OWNER_PASSWORD later rotates it; an in-app password change survives ordinary restarts.
# NEVER commit real production credentials.
OWNER_NAME=ReLoop Owner
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=replace-with-a-strong-owner-password

# Payment state remains manual-verification-only until real provider APIs/webhooks are implemented.

# DATABASE_PATH is an alias for DB_PATH; prefer a persistent Railway volume path.
# DATABASE_PATH=/app/data/reloop.db
# Node.js 20.12+ is required for built-in .env loading.

# Account recovery: configure a REAL SMTP service for email reset links.
# Until configured, recovery page directs users to Support; no email is claimed sent.
# Set APP_BASE_URL=https://your-domain.example in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
