{
  "name": "reloop-recycling",
  "version": "3.0.0",
  "private": true,
  "engines": {
    "node": ">=20.12"
  },
  "description": "ReLoop centralized recycling and circular-economy platform",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "check": "node --check server.js && find src scripts -name '*.js' -print0 | xargs -0 -n1 node --check",
    "backup": "node scripts/backup.js",
    "test:static": "node tests/static-validation.js",
    "test:schema": "python3 tests/schema-smoke.py",
    "pickups:generate": "node scripts/generate-recurring.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.7.0",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "qrcode": "^1.5.4"
  }
}
